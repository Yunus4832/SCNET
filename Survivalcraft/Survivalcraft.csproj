<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Survivalcraft</AssemblyName>
        <Version>$(ScNetworkVersion)</Version>
        <TargetFrameworks>$(GlobalTargetFramework);$(AndroidTargetFramework)</TargetFrameworks>
        <RootNamespace>Game</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.Survivalcraft</PackageId>
        <Description>Survivalcraft game runtime and mod development contract for SCNET.</Description>
        <PackageTags>scnet;survivalcraft;modding;game</PackageTags>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='$(GlobalTargetFramework)'">
        <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='$(AndroidTargetFramework)'">
        <SupportedOSPlatformVersion>$(MinAndroidApiVersion)</SupportedOSPlatformVersion>
        <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="0.9.5.2"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Content.Packaging\Content.Packaging.csproj"/>
        <ProjectReference Include="..\ContentTool\ContentTool.csproj" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\Engine\Engine.csproj"/>
        <ProjectReference Include="..\EntitySystem\EntitySystem.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Survivalcraft.Test</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <None Include="Modding\Survivalcraft.Mod.targets"
              Pack="true"
              PackagePath="buildTransitive\SCNET.Survivalcraft.targets"/>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\ContentTool\bin\$(Configuration)\$(GlobalTargetFramework)\SCNET.ContentTool.dll"
              Pack="true" PackagePath="tools\net10.0\any\SCNET.ContentTool.dll"/>
        <None Include="..\ContentTool\bin\$(Configuration)\$(GlobalTargetFramework)\SCNET.ContentTool.deps.json"
              Pack="true" PackagePath="tools\net10.0\any\SCNET.ContentTool.deps.json"/>
        <None Include="..\ContentTool\bin\$(Configuration)\$(GlobalTargetFramework)\SCNET.ContentTool.runtimeconfig.json"
              Pack="true" PackagePath="tools\net10.0\any\SCNET.ContentTool.runtimeconfig.json"/>
        <None Include="..\ContentTool\bin\$(Configuration)\$(GlobalTargetFramework)\SCNET.Content.Packaging.dll"
              Pack="true" PackagePath="tools\net10.0\any\SCNET.Content.Packaging.dll"/>
        <None Include="..\ContentTool\bin\$(Configuration)\$(GlobalTargetFramework)\SixLabors.ImageSharp.dll"
              Pack="true" PackagePath="tools\net10.0\any\SixLabors.ImageSharp.dll"/>
    </ItemGroup>

    <Import Project="..\SharedProperties\GlobalUsing.props"/>

</Project>
