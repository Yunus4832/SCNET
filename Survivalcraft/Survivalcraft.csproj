<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Survivalcraft</AssemblyName>
        <Version>$(ScNetworkVersion)</Version>
        <TargetFrameworks>$(GlobalTargetFramework);$(AndroidTargetFramework)</TargetFrameworks>
        <RootNamespace>Game</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.Survivalcraft</PackageId>
        <Description>Survivalcraft game runtime and mod development contract for SCNET.</Description>
        <PackageTags>scnet;survivalcraft;modding;game</PackageTags>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='$(GlobalTargetFramework)'">
        <DefineConstants>DESKTOP</DefineConstants>
        <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='$(AndroidTargetFramework)'">
        <SupportedOSPlatformVersion>$(MinAndroidApiVersion)</SupportedOSPlatformVersion>
        <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
        <DefineConstants>ANDROID</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='$(GlobalTargetFramework)'">
        <PackageReference Include="Clipboard.CSharp" Version="1.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="0.9.5.2"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Engine\Engine.csproj"/>
        <ProjectReference Include="..\EntitySystem\EntitySystem.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Modding\Survivalcraft.Mod.targets"
              Pack="true"
              PackagePath="buildTransitive\SCNET.Survivalcraft.targets"/>
    </ItemGroup>

    <Import Project="..\SharedProperties\GlobalUsing.props"/>

</Project>
