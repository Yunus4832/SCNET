<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>$(ContentPackagingVersion)</Version>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <AssemblyName>SCNET.Content.Packaging</AssemblyName>
        <RootNamespace>Content.Packaging</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.Content.Packaging</PackageId>
        <Description>SCNET unified .scpkg protocol reader, writer and validation contracts.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Engine.Media/Engine.Media.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
