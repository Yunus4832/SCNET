<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>$(EngineVersion)</Version>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.Engine.Serialization</PackageId>
        <Description>Serialization support for the SCNET engine.</Description>
        <PackageTags>scnet;engine;serialization</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System.Reflection"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Engine.Core/Engine.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
