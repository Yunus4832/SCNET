<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>$(ImageCodecsVersion)</Version>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.Native.ImageCodecs</PackageId>
        <Description>Native PNG, JPEG and WebP libraries used by SCNET.Engine.Media.</Description>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    </PropertyGroup>
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\"/>
        <None Include="..\ThirdPartyNotices.txt" Pack="true" PackagePath="\"/>
        <None Update="runtimes/linux-x64/native/libpng.so;runtimes/linux-x64/native/libwebp.so;runtimes/linux-x64/native/libsharpyuv.so;runtimes/linux-x64/native/libturbojpeg.so" Pack="true" PackagePath="runtimes/linux-x64/native/%(Filename)%(Extension)"/>
        <None Update="runtimes/win-x64/native/libpng16.dll;runtimes/win-x64/native/libwebp.dll;runtimes/win-x64/native/libsharpyuv.dll;runtimes/win-x64/native/turbojpeg.dll" Pack="true" PackagePath="runtimes/win-x64/native/%(Filename)%(Extension)"/>
        <None Update="runtimes/android-arm/native/libpng.so;runtimes/android-arm/native/libwebp.so;runtimes/android-arm/native/libturbojpeg.so" Pack="true" PackagePath="runtimes/android-arm/native/%(Filename)%(Extension)"/>
        <None Update="runtimes/android-arm64/native/libpng.so;runtimes/android-arm64/native/libwebp.so;runtimes/android-arm64/native/libturbojpeg.so" Pack="true" PackagePath="runtimes/android-arm64/native/%(Filename)%(Extension)"/>
        <None Update="runtimes/android-x86/native/libpng.so;runtimes/android-x86/native/libwebp.so;runtimes/android-x86/native/libturbojpeg.so" Pack="true" PackagePath="runtimes/android-x86/native/%(Filename)%(Extension)"/>
        <None Update="runtimes/android-x64/native/libpng.so;runtimes/android-x64/native/libwebp.so;runtimes/android-x64/native/libturbojpeg.so" Pack="true" PackagePath="runtimes/android-x64/native/%(Filename)%(Extension)"/>
    </ItemGroup>
</Project>
