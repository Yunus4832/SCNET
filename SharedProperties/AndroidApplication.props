<Project>
    <!-- Android 启动器应用的公共配置 -->
    <PropertyGroup>
        <AssemblyName>SurvivalcraftStarter</AssemblyName>
        <TargetFramework>$(AndroidTargetFramework)</TargetFramework>
        <SupportedOSPlatformVersion>$(MinAndroidApiVersion)</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <UsePackResourceTarget>true</UsePackResourceTarget>
        <UseRenameApkTarget Condition="'$(Configuration)' == 'Release'">true</UseRenameApkTarget>
        <AndroidManifest>..\SharedProperties\AndroidManifest.xml</AndroidManifest>
        <ApplicationVersion>$(AndroidReleaseCode)</ApplicationVersion>
        <ApplicationDisplayVersion>$(GameVersion)</ApplicationDisplayVersion>
        <Version>$(GameVersion)</Version>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)Android.props"/>

    <ItemGroup>
        <AndroidAsset Include="$(MSBuildProjectDirectory)\Content.zip" Link="Assets\Content.zip"/>
    </ItemGroup>

    <ItemGroup>
        <AndroidAsset Include="$(MSBuildThisFileDirectory)..\ThirdPartyNotices.txt"
                      Link="Assets\ThirdPartyNotices.txt"/>
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)GlobalUsing.props"/>
</Project>
