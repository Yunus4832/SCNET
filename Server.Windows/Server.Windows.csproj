<Project Sdk="Microsoft.NET.Sdk" InitialTargets="PackResource">
    <PropertyGroup>
        <AssemblyName>ServerStarter</AssemblyName>
        <OutputType>Exe</OutputType>
        <Version>$(ScNetworkVersion)</Version>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <DefineConstants>SERVER</DefineConstants>
        <StartProgram>Starter</StartProgram>
    </PropertyGroup>

    <!-- Release 配置 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <OutputFileName>SCNET_Server_Windows-$(Version).zip</OutputFileName>
        <UsePackOutputTarget>true</UsePackOutputTarget>
    </PropertyGroup>

    <PropertyGroup>
        <UsePackResourceTarget>true</UsePackResourceTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Survivalcraft\Survivalcraft.csproj" SetTargetFramework="TargetFramework=net10.0">
            <AdditionalProperties>DefineConstants=DESKTOP;SERVER</AdditionalProperties>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="Content.zip">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Import Project="..\SharedProperties\GlobalUsing.props"/>

</Project>
