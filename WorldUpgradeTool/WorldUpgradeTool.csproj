        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <AssemblyName>WorldUpgradeTool</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Engine\Engine.csproj" SetTargetFramework="TargetFramework=net10.0"/>
        <ProjectReference Include="..\EntitySystem\EntitySystem.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Engine.Core"/>
        <Using Include="Engine.Core.Random" Alias="Random"/>
        <Using Include="Engine.FileStorage"/>
        <Using Include="Game.Dialogs"/>
        <Using Include="Game.Managers"/>
        <Using Include="Game.Subsystems"/>
        <Using Include="Game.Terrains"/>
        <Using Include="Game.Utils"/>
    </ItemGroup>
</Project>
