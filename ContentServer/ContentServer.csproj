<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MediatR" Version="12.5.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11"/>
        <PackageReference Include="NetCorePal.Extensions.Domain.Abstractions" Version="3.2.1"/>
        <PackageReference Include="NetCorePal.Extensions.Dto" Version="3.2.1"/>
        <PackageReference Include="NetCorePal.Extensions.Repository.EntityFrameworkCore" Version="3.2.1"/>
    </ItemGroup>

    <!-- 组合前端：构建 ContentWebUI 并将 dist 发布到 wwwroot。两项目不直接引用，由统一 build target 协调。 -->
    <PropertyGroup>
        <ContentWebUIDist>$(MSBuildThisFileDirectory)..\ContentWebUI\dist</ContentWebUIDist>
        <ContentWebUIOutDir>$(MSBuildThisFileDirectory)wwwroot</ContentWebUIOutDir>
        <ContentWebUIProjectDir>$(MSBuildThisFileDirectory)..\ContentWebUI</ContentWebUIProjectDir>
    </PropertyGroup>

    <Target Name="BuildContentWebUI" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' AND Exists('$(ContentWebUIProjectDir)\package.json')">
        <!-- 需要 Node/npm；若环境无 Node，可在分布环境预先构建 dist -->
        <Exec Command="npm run build" WorkingDirectory="$(ContentWebUIProjectDir)"/>
    </Target>

    <Target Name="CopyContentWebUI" AfterTargets="Build" BeforeTargets="Publish" Condition="Exists('$(ContentWebUIDist)\index.html')">
        <!-- 清理上次拷贝的前端产物，避免残留 -->
        <ItemGroup>
            <_OldWebFiles Include="$(ContentWebUIOutDir)\*.html;$(ContentWebUIOutDir)\site.css;$(ContentWebUIOutDir)\site.js"/>
            <_OldWebAssetDir Include="$(ContentWebUIOutDir)\assets"/>
        </ItemGroup>
        <Delete Files="@(_OldWebFiles)"/>
        <RemoveDir Directories="@(_OldWebAssetDir)"/>
        <!-- 拷贝最新产物 -->
        <ItemGroup>
            <_WebFiles Include="$(ContentWebUIDist)\**\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(_WebFiles)" DestinationFiles="@(_WebFiles->'$(ContentWebUIOutDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
        <Message Importance="high" Text="[ContentServer] 已发布前端产物到 wwwroot"/>
    </Target>
</Project>
