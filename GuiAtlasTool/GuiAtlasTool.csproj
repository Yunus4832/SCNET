<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <AssemblyName>SCNET.GuiAtlasTool</AssemblyName>
        <RootNamespace>Scnet.GuiAtlasTool</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4"/>
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12"/>
        <PackageReference Include="Svg.Skia" Version="4.9.1"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
