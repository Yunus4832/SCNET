# Copy this file to server.conf, then run ./deploy.sh.
INSTANCE=server
SESSION=survival
WORLD=World
SEED=123456
GAME_MODE=Survival
SERVER_PORT=28887

# Optional HTTP control on the host loopback interface; use SSH forwarding remotely.
HTTP_COMMAND=false
HTTP_COMMAND_PORT=28889
# At least 32 non-whitespace characters. Empty uses the persistent instance token.
HTTP_COMMAND_ACCESS_TOKEN=''

# Required only when MODS is nonempty. The URL must be reachable from the container.
CONTENT_SERVER=

# One "mod-id version" pair per line. Empty means no mods.
MODS='
'

# Optional signaling room. This does not replace the ordinary game port.
P2P=false
RENDEZVOUS=
ROOM_NAME=World
ROOM_DESCRIPTION=
ROOM_PUBLIC=false

# Optional admission override: empty inherits the saved session/world; open, password or external.
ADMISSION=
# Container-visible private file, for example /app/Instances/server/Config/join-password.txt.
# It contains one password line. No plaintext password belongs in this configuration.
SERVER_PASSWORD_FILE=
# External mode needs public URL and SPKI base64url key. Server startup makes no HTTP request.
AUTHENTICATION_URL=
AUTHENTICATION_KEY=
AUTHENTICATION_NAME=
