<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>__SCNET_MOD_VERSION__</Version>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Survivalcraft.ModTemplate</AssemblyName>
        <RootNamespace>Survivalcraft.ModTemplate</RootNamespace>
        <SurvivalcraftModId>example.mod</SurvivalcraftModId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SCNET.Survivalcraft"
                          Version="__SCNET_GAME_VERSION__"
                          ExcludeAssets="runtime"/>
        <PackageReference Include="SCNET.ContentTool"
                          Version="__SCNET_CONTENT_TOOL_VERSION__"
                          PrivateAssets="all"/>
    </ItemGroup>
</Project>
