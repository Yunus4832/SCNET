<Project>
    <!-- 检查是否定义了 UsePackAssetsTarget 属性 -->
    <PropertyGroup>
        <UsePackAssetsTarget Condition="'$(UsePackAssetsTarget)' == ''">false</UsePackAssetsTarget>
        <SolutionRoot>$(MSBuildThisFileDirectory)</SolutionRoot>
    </PropertyGroup>

    <PropertyGroup>
        <_GuiAtlasSourceDirectory>$(SolutionRoot)Tools/GuiAtlasTool/Assets</_GuiAtlasSourceDirectory>
        <_GuiAtlasTexture>$(SolutionRoot)Assets/Client/Atlases/AtlasTexture.webp</_GuiAtlasTexture>
        <_GuiAtlasDefinition>$(SolutionRoot)Assets/Client/Atlases/Atlas.txt</_GuiAtlasDefinition>
        <_GuiAtlasToolProject>$(SolutionRoot)Tools/GuiAtlasTool/GuiAtlasTool.csproj</_GuiAtlasToolProject>
        <_GuiAtlasToolAssembly>$(SolutionRoot)Tools/GuiAtlasTool/bin/$(Configuration)/$(GlobalTargetFramework)/SCNET.GuiAtlasTool.dll</_GuiAtlasToolAssembly>
    </PropertyGroup>

    <ItemGroup>
        <SharedAssetFiles Include="$(SolutionRoot)Assets/Shared/**/*"/>
        <ClientAssetFiles Include="$(SolutionRoot)Assets/Client/**/*" Exclude="$(_GuiAtlasTexture);$(_GuiAtlasDefinition)" AssetDirectory="%(RecursiveDir)"/>
        <ClientAssetFiles Include="$(_GuiAtlasTexture);$(_GuiAtlasDefinition)" AssetDirectory="Atlases/"/>
        <_GuiAtlasSources Include="$(_GuiAtlasSourceDirectory)/**/*.svg;$(_GuiAtlasSourceDirectory)/**/*.png;$(_GuiAtlasSourceDirectory)/**/*.webp"/>
        <_GuiAtlasToolSources Include="$(SolutionRoot)Tools/GuiAtlasTool/**/*.cs;$(SolutionRoot)Tools/GuiAtlasTool/GuiAtlasTool.csproj"
                              Exclude="$(SolutionRoot)Tools/GuiAtlasTool/bin/**/*;$(SolutionRoot)Tools/GuiAtlasTool/obj/**/*"/>
    </ItemGroup>

    <!-- 图集工具作为主机工具参与构建依赖排序。 -->
    <ItemGroup Condition="'$(UsePackAssetsTarget)' == 'true' and '$(SharedAssetsOnly)' != 'true'">
        <ProjectReference Include="$(_GuiAtlasToolProject)"
                          ReferenceOutputAssembly="false"
                          Private="false"
                          PrivateAssets="all"
                          ExcludeAssets="all"
                          SkipGetTargetFrameworkProperties="true"
                          GlobalPropertiesToRemove="NoBuild;DeployOnBuild;EnableDefaultItems;EnableDefaultCompileItems;TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;TargetPlatformIdentifier;TargetPlatformVersion;TargetPlatformMinVersion;SupportedOSPlatformVersion;OutputPath;IntermediateOutputPath;BaseOutputPath;BaseIntermediateOutputPath"/>
    </ItemGroup>

    <Target Name="GenerateGuiAtlas"
            BeforeTargets="GenerateAssetManifest"
            Condition="'$(UsePackAssetsTarget)' == 'true' and '$(SharedAssetsOnly)' != 'true'"
            Inputs="@(_GuiAtlasSources);$(_GuiAtlasSourceDirectory);@(_GuiAtlasToolSources)"
            Outputs="$(_GuiAtlasTexture);$(_GuiAtlasDefinition)">
        <Exec Command="dotnet &quot;$(_GuiAtlasToolAssembly)&quot; generate &quot;$(_GuiAtlasSourceDirectory)&quot; &quot;$(_GuiAtlasTexture)&quot; &quot;$(_GuiAtlasDefinition)&quot;"/>
    </Target>

    <Target Name="GenerateAssetManifest"
            Condition="'$(UsePackAssetsTarget)' == 'true'">
        <ItemGroup>
            <_LogicalPath Include="@(SharedAssetFiles->'%(RecursiveDir)%(Filename)%(Extension)')"/>
            <_LogicalPath Include="@(ClientAssetFiles->'%(AssetDirectory)%(Filename)%(Extension)')"/>
        </ItemGroup>
        <RemoveDuplicates Inputs="@(_LogicalPath)">
            <Output TaskParameter="HadAnyDuplicates" PropertyName="_DuplicateAssetPaths"/>
        </RemoveDuplicates>
        <Error Condition="'$(_DuplicateAssetPaths)' == 'true'" Text="Shared and Client assets must have distinct logical paths."/>
        <MakeDir Directories="$(IntermediateOutputPath)"/>
        <WriteLinesToFile File="$(IntermediateOutputPath)SharedAssets.manifest" Lines="@(SharedAssetFiles)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
        <WriteLinesToFile File="$(IntermediateOutputPath)ClientAssets.manifest" Lines="@(ClientAssetFiles)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
    </Target>

    <Target Name="PackSharedAssets" DependsOnTargets="GenerateAssetManifest"
            Inputs="@(SharedAssetFiles);$(IntermediateOutputPath)SharedAssets.manifest" Outputs="$(MSBuildProjectDirectory)/SharedAssets.zip">
        <ZipDirectory SourceDirectory="$(SolutionRoot)Assets/Shared" DestinationFile="$(MSBuildProjectDirectory)/SharedAssets.zip" Overwrite="true"/>
    </Target>

    <Target Name="PackClientAssets" Condition="'$(SharedAssetsOnly)' != 'true'" DependsOnTargets="GenerateAssetManifest"
            Inputs="@(ClientAssetFiles);$(IntermediateOutputPath)ClientAssets.manifest" Outputs="$(MSBuildProjectDirectory)/ClientAssets.zip">
        <ZipDirectory SourceDirectory="$(SolutionRoot)Assets/Client" DestinationFile="$(MSBuildProjectDirectory)/ClientAssets.zip" Overwrite="true"/>
    </Target>

    <Target Name="PackAssets" BeforeTargets="BeforeBuild" Condition="'$(UsePackAssetsTarget)' == 'true'"
            DependsOnTargets="ResolveProjectReferences;PackSharedAssets;PackClientAssets"/>

    <!-- 检查是否定义了 OutputFileName 属性 -->
    <PropertyGroup>
        <UsePackOutputTarget Condition="'$(OutputFileName)' == ''">false</UsePackOutputTarget>
    </PropertyGroup>

    <!-- 只有当 UsePackOutputTarget 为 true 时才导入目标 -->
    <Target Name="PackOutput" AfterTargets="Publish" Condition="'$(UsePackOutputTarget)' == 'true'">
        <!-- 执行打包操作 -->
        <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(SolutionRoot)/Publish/$(OutputFileName)" Overwrite="true"/>
    </Target>

    <!-- 检查是否定义了 OutputApkName 属性 -->
    <PropertyGroup>
        <UseRenameApkTarget Condition="'$(OutputApkName)' == ''">false</UseRenameApkTarget>
    </PropertyGroup>

    <!-- 只有当 UseRenameApkTarget 为 true 时才导入目标 -->
    <Target Name="RenameApk" AfterTargets="Publish" Condition="'$(UseRenameApkTarget)' == 'true'">
        <!-- 重命名 Apk -->
        <Copy SourceFiles="$([System.IO.Path]::GetFullPath('$(OutputPath)$(ApplicationId)-Signed.apk'))"
              DestinationFiles="$(SolutionRoot)/Publish/$(OutputApkName)"/>
    </Target>

</Project>
