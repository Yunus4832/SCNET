<Project>
    <!-- 检查是否定义了 UsePackResourceTarget 属性 -->
    <PropertyGroup>
        <UsePackResourceTarget Condition="'$(UsePackResourceTarget)' == ''">false</UsePackResourceTarget>
        <SolutionRoot>$(MSBuildThisFileDirectory)</SolutionRoot>
    </PropertyGroup>

    <PropertyGroup>
        <_GuiAtlasSourceDirectory>$(SolutionRoot)GuiAtlasTool/Assets</_GuiAtlasSourceDirectory>
        <_GuiAtlasTexture>$(SolutionRoot)Content/Assets/Atlases/AtlasTexture.webp</_GuiAtlasTexture>
        <_GuiAtlasDefinition>$(SolutionRoot)Content/Assets/Atlases/Atlas.txt</_GuiAtlasDefinition>
        <_GuiAtlasToolProject>$(SolutionRoot)GuiAtlasTool/GuiAtlasTool.csproj</_GuiAtlasToolProject>
        <_GuiAtlasToolAssembly>$(SolutionRoot)GuiAtlasTool/bin/$(Configuration)/$(GlobalTargetFramework)/SCNET.GuiAtlasTool.dll</_GuiAtlasToolAssembly>
    </PropertyGroup>

    <ItemGroup>
        <MyContentFiles Include="$(SolutionRoot)Content/**/*.*"
                        Exclude="$(_GuiAtlasTexture);$(_GuiAtlasDefinition)"/>
        <MyContentFiles Include="$(_GuiAtlasTexture);$(_GuiAtlasDefinition)"/>
        <_GuiAtlasSources Include="$(_GuiAtlasSourceDirectory)/**/*.svg;$(_GuiAtlasSourceDirectory)/**/*.png;$(_GuiAtlasSourceDirectory)/**/*.webp"/>
        <_GuiAtlasToolSources Include="$(SolutionRoot)GuiAtlasTool/**/*.cs;$(SolutionRoot)GuiAtlasTool/GuiAtlasTool.csproj"
                              Exclude="$(SolutionRoot)GuiAtlasTool/bin/**/*;$(SolutionRoot)GuiAtlasTool/obj/**/*"/>
    </ItemGroup>

    <!-- 图集工具作为主机工具参与构建依赖排序。 -->
    <ItemGroup Condition="'$(UsePackResourceTarget)' == 'true'">
        <ProjectReference Include="$(_GuiAtlasToolProject)"
                          ReferenceOutputAssembly="false"
                          Private="false"
                          PrivateAssets="all"
                          ExcludeAssets="all"
                          SkipGetTargetFrameworkProperties="true"
                          GlobalPropertiesToRemove="NoBuild;DeployOnBuild;EnableDefaultItems;EnableDefaultCompileItems;TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;TargetPlatformIdentifier;TargetPlatformVersion;TargetPlatformMinVersion;SupportedOSPlatformVersion;OutputPath;IntermediateOutputPath;BaseOutputPath;BaseIntermediateOutputPath"/>
    </ItemGroup>

    <Target Name="GenerateGuiAtlas"
            BeforeTargets="GenerateContentManifest"
            Condition="'$(UsePackResourceTarget)' == 'true'"
            Inputs="@(_GuiAtlasSources);$(_GuiAtlasSourceDirectory);@(_GuiAtlasToolSources)"
            Outputs="$(_GuiAtlasTexture);$(_GuiAtlasDefinition)">
        <Exec Command="dotnet &quot;$(_GuiAtlasToolAssembly)&quot; generate &quot;$(_GuiAtlasSourceDirectory)&quot; &quot;$(_GuiAtlasTexture)&quot; &quot;$(_GuiAtlasDefinition)&quot;"/>
    </Target>

    <Target Name="GenerateContentManifest"
            BeforeTargets="PackResource"
            Condition="'$(UsePackResourceTarget)' == 'true'">
        <PropertyGroup>
            <_ContentManifest>$(IntermediateOutputPath)ContentFiles.manifest</_ContentManifest>
        </PropertyGroup>
        <MakeDir Directories="$(IntermediateOutputPath)"/>
        <WriteLinesToFile File="$(_ContentManifest)"
                          Lines="@(MyContentFiles->'%(FullPath)')"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true"/>
    </Target>

    <!-- 增量打包资源 -->
    <Target Name="PackResource"
            BeforeTargets="BeforeBuild"
            DependsOnTargets="ResolveProjectReferences"
            Condition="'$(UsePackResourceTarget)' == 'true'"
            Inputs="@(MyContentFiles);$(_ContentManifest)"
            Outputs="$(MSBuildProjectDirectory)/Content.zip">
        <Message Text="[PackResource] 正在执行增量打包..." Importance="high"/>
        <ZipDirectory SourceDirectory="$(SolutionRoot)Content" DestinationFile="$(MSBuildProjectDirectory)/Content.zip" Overwrite="true"/>
    </Target>

    <!-- 检查是否定义了 OutputFileName 属性 -->
    <PropertyGroup>
        <UsePackOutputTarget Condition="'$(OutputFileName)' == ''">false</UsePackOutputTarget>
    </PropertyGroup>

    <!-- 只有当 UsePackOutputTarget 为 true 时才导入目标 -->
    <Target Name="PackOutput" AfterTargets="Publish" Condition="'$(UsePackOutputTarget)' == 'true'">
        <!-- 执行打包操作 -->
        <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(SolutionRoot)/Publish/$(OutputFileName)" Overwrite="true"/>
    </Target>

    <!-- 检查是否定义了 OutputApkName 属性 -->
    <PropertyGroup>
        <UseRenameApkTarget Condition="'$(OutputApkName)' == ''">false</UseRenameApkTarget>
    </PropertyGroup>

    <!-- 只有当 UseRenameApkTarget 为 true 时才导入目标 -->
    <Target Name="RenameApk" AfterTargets="Publish" Condition="'$(UseRenameApkTarget)' == 'true'">
        <!-- 重命名 Apk -->
        <Copy SourceFiles="$([System.IO.Path]::GetFullPath('$(OutputPath)$(ApplicationId)-Signed.apk'))"
              DestinationFiles="$(SolutionRoot)/Publish/$(OutputApkName)"/>
    </Target>

</Project>
