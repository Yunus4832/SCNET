<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <Version>$(UiPreviewToolVersion)</Version>
        <AssemblyName>SCNET.UiPreviewTool</AssemblyName>
        <RootNamespace>Scnet.UiPreviewTool</RootNamespace>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Survivalcraft/Survivalcraft.csproj" SetTargetFramework="TargetFramework=net10.0">
            <AdditionalProperties>RuntimeIdentifier=$(RuntimeIdentifier)</AdditionalProperties>
        </ProjectReference>
        <Content Include="Samples\*.xml" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
