# Copy to provider.env and restrict it to the deploying user (chmod 600).
# Clients require trusted HTTPS. Terminate TLS at a reverse proxy to the loopback listener.
Logging__LogLevel__Default=Warning
Authentication__PublicUrl=https://auth.example.org/
Authentication__DisplayName=SCNET Authentication
# Add accounts using the output of --hash-password (password is read from stdin).
# Do not put plaintext passwords, player private keys or game joining passwords here.
# Authentication__Accounts__alice=PASTE_ASPNET_IDENTITY_PASSWORD_HASH
# Exact immediate reverse proxy IPs only. Defaults trust 127.0.0.1 and ::1.
# For container bridge networking set the actual proxy source IP observed by the container.
# Authentication__TrustedProxies__0=172.17.0.1
