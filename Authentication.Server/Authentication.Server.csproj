<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <Version>$(AuthenticationServerVersion)</Version>
        <UseAppHost>false</UseAppHost>
        <SelfContained>false</SelfContained>
        <UsePackOutputTarget Condition="'$(Configuration)' == 'Release'">true</UsePackOutputTarget>
        <OutputFileName>authentication-server-$(AuthenticationServerVersion)-portable.zip</OutputFileName>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <RootNamespace>SCNET.Authentication.Server</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Authentication.Protocol/Authentication.Protocol.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="Deployment/run.sh" CopyToPublishDirectory="PreserveNewest"/>
        <None Update="Deployment/run.ps1" CopyToPublishDirectory="PreserveNewest"/>
        <None Update="Deployment/provider.json.example" CopyToPublishDirectory="PreserveNewest"/>
        <None Update="Deployment/provider.env.example" CopyToPublishDirectory="PreserveNewest"/>
        <None Update="README.md" CopyToPublishDirectory="PreserveNewest"/>
        <Content Include="../ThirdPartyNotices.txt" Link="ThirdPartyNotices.txt" CopyToPublishDirectory="PreserveNewest"/>
        <Content Remove="**/appsettings*.json;AuthenticationData/**;**/*.p8;**/*.pfx;**/*.key;**/authorizations.json;**/provider.env"/>
    </ItemGroup>
</Project>
