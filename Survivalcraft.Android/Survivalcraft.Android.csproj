<Project Sdk="Microsoft.NET.Sdk" InitialTargets="PackResource">
    <PropertyGroup>
        <AssemblyName>SurvivalcraftStarter</AssemblyName>
        <Platforms>AnyCPU</Platforms>
        <TargetFramework>$(AndroidTargetFramework)</TargetFramework>
        <SupportedOSPlatformVersion>$(MinAndroidApiVersion)</SupportedOSPlatformVersion>
        <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
        <OutputType>Exe</OutputType>
        <DefineConstants>ANDROID</DefineConstants>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <!-- 安卓相关配置 -->
    <Import Project="..\SharedProperties\Android.props"/>

    <!--声明需要打包资源-->
    <PropertyGroup>
        <UsePackResourceTarget>true</UsePackResourceTarget>
    </PropertyGroup>

    <!-- Debug 配置 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    </PropertyGroup>

    <!-- Release 配置 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>$(ProjectDir)..\Publish\Android\Content-Arm64</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <OutputApkName>SCNET_Arm64-$(Version).apk</OutputApkName>
        <UseRenameApkTarget>true</UseRenameApkTarget>
    </PropertyGroup>

    <ItemGroup>
        <AndroidAsset Include="Content.scpak" Link="Assets\Content.scpak"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 这里的 TargetFramework, RuntimeIdendifier 必须硬编码，MSBuild 的限制，请勿修改 -->
        <ProjectReference Include="..\Survivalcraft\Survivalcraft.csproj" SetTargetFramework="TargetFramework=net10.0-android36.0">
            <AdditionalProperties>RuntimeIdentifier=android-arm64</AdditionalProperties>
        </ProjectReference>
    </ItemGroup>

    <Import Project="..\SharedProperties\GlobalUsing.props"/>

</Project>
