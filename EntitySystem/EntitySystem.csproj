<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>EngineSystem</AssemblyName>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.EntitySystem</PackageId>
        <Description>Entity, component, subsystem, and template database runtime used by SCNET.</Description>
        <PackageTags>scnet;entity-component-system;ecs</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.7"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Reflection"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Engine.Serialization\Engine.Serialization.csproj"/>
    </ItemGroup>

</Project>
