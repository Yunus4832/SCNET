<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>$(OpenALVersion)</Version>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.Native.OpenAL</PackageId>
        <Description>OpenAL Soft native libraries for Windows, Linux and Android.</Description>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\"/>
        <None Include="..\ThirdPartyNotices.txt" Pack="true" PackagePath="\"/>
        <None Update="runtimes/android-arm/native/libopenal.so" Pack="true" PackagePath="runtimes/android-arm/native/libopenal.so"/>
        <None Update="runtimes/android-arm64/native/libopenal.so" Pack="true" PackagePath="runtimes/android-arm64/native/libopenal.so"/>
        <None Update="runtimes/android-x86/native/libopenal.so" Pack="true" PackagePath="runtimes/android-x86/native/libopenal.so"/>
        <None Update="runtimes/android-x64/native/libopenal.so" Pack="true" PackagePath="runtimes/android-x64/native/libopenal.so"/>
        <None Update="runtimes/linux-x64/native/libopenal.so" Pack="true" PackagePath="runtimes/linux-x64/native/libopenal.so"/>
        <None Update="runtimes/win-x64/native/soft_oal.dll" Pack="true" PackagePath="runtimes/win-x64/native/soft_oal.dll"/>
    </ItemGroup>
</Project>
