<Project Sdk="Microsoft.NET.Sdk" InitialTargets="PackResource">

    <PropertyGroup>
        <Version>$(GameVersion)</Version>
        <AssemblyName>SurvivalcraftStarter</AssemblyName>
        <OutputType>WinExe</OutputType>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <ApplicationIcon>..\SharedResources\AppIcon\icon.ico</ApplicationIcon>
        <StartProgram>Starter</StartProgram>
    </PropertyGroup>

    <!-- Release 配置 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <OutputFileName>SCNET_Linux-$(GameVersion).zip</OutputFileName>
        <UsePackOutputTarget>true</UsePackOutputTarget>
    </PropertyGroup>

    <!--声明需要打包资源-->
    <PropertyGroup>
        <UsePackResourceTarget>true</UsePackResourceTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Desktop.UpdateTransactions/Desktop.UpdateTransactions.csproj"/>
        <None Update="DesktopRelease.xml" CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Content.zip">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\SharedResources\AppIcon\icon.png"
                          Link="Resources\icon.png" LogicalName="Starter.Resources.icon.png"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Tmds.DBus" Version="0.94.2"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 这里的 TargetFramework, RuntimeIdendifier 必须硬编码，MSBuid 的限制，请勿修改 -->
        <ProjectReference Include="../Survivalcraft/Survivalcraft.csproj" SetTargetFramework="TargetFramework=net10.0">
            <AdditionalProperties>RuntimeIdentifier=linux-x64</AdditionalProperties>
        </ProjectReference>
    </ItemGroup>

    <Target Name="BuildLinuxServerImage"
            AfterTargets="PackOutput"
            Condition="'$(Configuration)' == 'Release' AND '$(BuildLinuxServerImage)' != 'false' AND $([MSBuild]::IsOSPlatform('Linux'))">
        <Exec Command="bash &quot;$(MSBuildProjectDirectory)/Deployment/build-image.sh&quot;"
              EnvironmentVariables="SCNET_PUBLISH_DIR=$(PublishDir);GAME_VERSION=$(GameVersion);OUTPUT_DIR=$(SolutionRoot)Publish"/>
    </Target>

    <ItemGroup>
        <Content Include="..\ThirdPartyNotices.txt" Link="ThirdPartyNotices.txt"
                 CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest"
                 ExcludeFromSingleFile="true"/>
    </ItemGroup>

</Project>
