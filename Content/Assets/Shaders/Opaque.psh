#include "Shaders/Atmosphere.txt"
#ifdef HLSL
Texture2D u_texture;
SamplerState u_samplerState;
#ifdef ALPHATESTED
float u_alphaThreshold;
#endif

void main(
    in float4 v_color : COLOR,
    in float2 v_texcoord : TEXCOORD,
    in float3 v_viewOffset : TEXCOORD2,
    in float4 v_skyPosition : TEXCOORD1,
    out float4 svTarget : SV_TARGET
)
{
    float4 result = v_color * u_texture.Sample(u_samplerState, v_texcoord);
#ifdef ALPHATESTED
    if (result.a <= u_alphaThreshold) { discard; }
#endif
#ifdef OPAQUE_CUTOUT
    result.rgb /= result.a;
    result.a = 1.0;
#endif
    svTarget = applyAtmosphere(result, v_viewOffset, float3(0.0, 1.0, 0.0), v_skyPosition);
}
#endif

#ifdef GLSL
// <Sampler Name='u_samplerState' Texture='u_texture' />
#ifdef GL_ES
precision mediump float;
#endif
uniform sampler2D u_texture;
#ifdef ALPHATESTED
uniform float u_alphaThreshold;
#endif

varying vec4 v_color;
varying vec2 v_texcoord;
#ifdef GL_ES
varying highp vec3 v_viewOffset;
varying highp vec4 v_skyPosition;
#else
varying vec3 v_viewOffset;
varying vec4 v_skyPosition;
#endif

void main()
{
    vec4 result = v_color * texture2D(u_texture, v_texcoord);
#ifdef ALPHATESTED
    if (result.a <= u_alphaThreshold) { discard; }
#endif
#ifdef OPAQUE_CUTOUT
    result.rgb /= result.a;
    result.a = 1.0;
#endif
    gl_FragColor = applyAtmosphere(result, v_viewOffset, vec3(0.0, 1.0, 0.0), v_skyPosition);
}
#endif
