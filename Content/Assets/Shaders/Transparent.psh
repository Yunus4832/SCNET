#ifdef HLSL

Texture2D u_texture;
SamplerState u_samplerState;
float3 u_fogColor;
#ifdef SKY_FOG
Texture2D u_skyTexture;
SamplerState u_skySampler;
float u_skyFogEnabled;
#endif

void main(
	in float4 v_color : COLOR,
	in float2 v_texcoord: TEXCOORD,
	in float v_fog : FOG,
#ifdef SKY_FOG
    in float4 v_skyPosition : TEXCOORD1,
#endif
	out float4 svTarget: SV_TARGET
)
{
	// Color
	float4 result = v_color;

	// Texture
	result *= u_texture.Sample(u_samplerState, v_texcoord);
	
	// Fog
    float fog = saturate(v_fog);
    float3 fogColor = u_fogColor;
#ifdef SKY_FOG
    if (u_skyFogEnabled > 0.5 && fog > 0.0)
    {
        float2 skyUv = v_skyPosition.xy / v_skyPosition.w * float2(0.5, -0.5) + 0.5;
        fogColor = u_skyTexture.Sample(u_skySampler, skyUv).rgb;
    }
#endif
	float4 premultipliedFogColor = float4(fogColor * result.a, result.a);
	result = lerp(result, premultipliedFogColor, fog);
	
	// Return
	svTarget = result;
}

#endif
#ifdef GLSL

// <Sampler Name='u_samplerState' Texture='u_texture' />

#ifdef GL_ES
precision mediump float;
#endif

uniform sampler2D u_texture;
uniform vec3 u_fogColor;
#ifdef SKY_FOG
// <Sampler Name='u_skySampler' Texture='u_skyTexture' />
uniform sampler2D u_skyTexture;
uniform float u_skyFogEnabled;
#ifdef GL_ES
varying highp vec4 v_skyPosition;
#else
varying vec4 v_skyPosition;
#endif
#endif

varying vec4 v_color;
varying vec2 v_texcoord;
varying float v_fog;
	
void main()
{
	// Color
	vec4 result = v_color;

	// Texture
	result *= texture2D(u_texture, v_texcoord);
	
	// Fog
    float fog = clamp(v_fog, 0.0, 1.0);
    vec3 fogColor = u_fogColor;
#ifdef SKY_FOG
    if (u_skyFogEnabled > 0.5 && fog > 0.0)
    {
#ifdef GL_ES
        highp vec2 skyUv = v_skyPosition.xy / v_skyPosition.w * vec2(0.5, -0.5) + 0.5;
#else
        vec2 skyUv = v_skyPosition.xy / v_skyPosition.w * vec2(0.5, -0.5) + 0.5;
#endif
        fogColor = texture2D(u_skyTexture, skyUv).rgb;
    }
#endif
	vec4 premultipliedFogColor = vec4(fogColor * result.a, result.a);
	result = mix(result, premultipliedFogColor, fog);
	
	// Return
	gl_FragColor = result;
}

#endif