#if defined(GLSL) && defined(FRAMEBUFFER_DEPTH_FETCH)
#extension GL_ARM_shader_framebuffer_fetch_depth_stencil : require
#endif
#include "Shaders/Atmosphere.txt"
#ifdef HLSL
Texture2D u_texture;
SamplerState u_samplerState;
#ifdef ALPHATESTED
float u_alphaThreshold;
#endif
Texture2D u_sceneDepth;
SamplerState u_sceneDepthSampler;
float2 u_depthUvScale;
float2 u_depthScaleBias;
float4 u_depthProjection;
float3 u_viewDirection;
float u_underWater;

void main(
    in float4 v_color : COLOR,
    in float2 v_texcoord : TEXCOORD,
    in float3 v_viewOffset : TEXCOORD2,
    in float4 v_skyPosition : TEXCOORD1,
    out float4 svTarget : SV_TARGET
)
{
    float4 result = v_color * u_texture.Sample(u_samplerState, v_texcoord);
#ifdef ALPHATESTED
    if (result.a <= u_alphaThreshold) { discard; }
#endif
#ifdef OPAQUE_CUTOUT
    result.rgb /= result.a;
    result.a = 1.0;
#endif
    if (u_underWater < 0.5 && result.a > 0.0001)
    {
        float2 ndc = v_skyPosition.xy / v_skyPosition.w;
        float depth = u_sceneDepth.Sample(u_sceneDepthSampler, ndc * u_depthUvScale + 0.5).r;
        float clipDepth = depth * u_depthScaleBias.x + u_depthScaleBias.y;
        float sceneZ = (u_depthProjection.y - clipDepth * u_depthProjection.w) /
            (clipDepth * u_depthProjection.z - u_depthProjection.x);
        float surfaceZ = max(dot(v_viewOffset, u_viewDirection), 0.0001);
        float thickness = depth >= 0.999999 ? 256.0 :
            max((abs(sceneZ) / surfaceZ - 1.0) * length(v_viewOffset), 0.0);
        float alpha = 1.0 - (1.0 - result.a) * exp(-0.08 * thickness);
        result.rgb *= alpha / result.a;
        result.a = alpha;
    }

    svTarget = applyAtmosphere(result, v_viewOffset, float3(0.0, 1.0, 0.0), v_skyPosition);
}
#endif

#ifdef GLSL
// <Sampler Name='u_samplerState' Texture='u_texture' />
#ifdef GL_ES
precision mediump float;
#endif
uniform sampler2D u_texture;
#ifdef ALPHATESTED
uniform float u_alphaThreshold;
#endif
#ifndef FRAMEBUFFER_DEPTH_FETCH
// <Sampler Name='u_sceneDepthSampler' Texture='u_sceneDepth' />
#ifdef GL_ES
uniform highp sampler2D u_sceneDepth;
uniform highp vec2 u_depthUvScale;
uniform highp vec2 u_depthScaleBias;
uniform highp vec4 u_depthProjection;
uniform highp vec3 u_viewDirection;
#else
uniform sampler2D u_sceneDepth;
uniform vec2 u_depthUvScale;
uniform vec2 u_depthScaleBias;
uniform vec4 u_depthProjection;
uniform vec3 u_viewDirection;
#endif
#endif
#ifdef FRAMEBUFFER_DEPTH_FETCH
uniform highp vec2 u_depthScaleBias;
uniform highp vec4 u_depthProjection;
uniform highp vec3 u_viewDirection;
#endif
uniform float u_underWater;

varying vec4 v_color;
varying vec2 v_texcoord;
#ifdef GL_ES
varying highp vec3 v_viewOffset;
varying highp vec4 v_skyPosition;
#else
varying vec3 v_viewOffset;
varying vec4 v_skyPosition;
#endif

void main()
{
    vec4 result = v_color * texture2D(u_texture, v_texcoord);
#ifdef ALPHATESTED
    if (result.a <= u_alphaThreshold) { discard; }
#endif
#ifdef OPAQUE_CUTOUT
    result.rgb /= result.a;
    result.a = 1.0;
#endif
    if (u_underWater < 0.5 && result.a > 0.0001)
    {
#ifdef GL_ES
#ifdef FRAMEBUFFER_DEPTH_FETCH
        highp float depth = gl_LastFragDepthARM;
#else
        highp vec2 ndc = v_skyPosition.xy / v_skyPosition.w;
        highp float depth = texture2D(u_sceneDepth, ndc * u_depthUvScale + 0.5).r;
#endif
        highp float clipDepth = depth * u_depthScaleBias.x + u_depthScaleBias.y;
        highp float sceneZ = (u_depthProjection.y - clipDepth * u_depthProjection.w) /
            (clipDepth * u_depthProjection.z - u_depthProjection.x);
        highp float surfaceZ = max(dot(v_viewOffset, u_viewDirection), 0.0001);
        highp float thickness = depth >= 0.999999 ? 256.0 :
            max((abs(sceneZ) / surfaceZ - 1.0) * length(v_viewOffset), 0.0);
#else
        vec2 ndc = v_skyPosition.xy / v_skyPosition.w;
        float depth = texture2D(u_sceneDepth, ndc * u_depthUvScale + 0.5).r;
        float clipDepth = depth * u_depthScaleBias.x + u_depthScaleBias.y;
        float sceneZ = (u_depthProjection.y - clipDepth * u_depthProjection.w) /
            (clipDepth * u_depthProjection.z - u_depthProjection.x);
        float surfaceZ = max(dot(v_viewOffset, u_viewDirection), 0.0001);
        float thickness = depth >= 0.999999 ? 256.0 :
            max((abs(sceneZ) / surfaceZ - 1.0) * length(v_viewOffset), 0.0);
#endif
        float alpha = 1.0 - (1.0 - result.a) * exp(-0.08 * thickness);
        result.rgb *= alpha / result.a;
        result.a = alpha;
    }

    gl_FragColor = applyAtmosphere(result, v_viewOffset, vec3(0.0, 1.0, 0.0), v_skyPosition);
}
#endif
