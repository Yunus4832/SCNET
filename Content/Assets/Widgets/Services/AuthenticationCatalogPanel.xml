<CanvasWidget xmlns="runtime-namespace:Game.Widgets">
    <CanvasWidget>
        <CanvasWidget Margin="10, 66">
            <BevelledRectangleWidget Style="{Styles/Area}" />
            <StackPanelWidget Direction="Vertical">
                <CanvasWidget Size="Infinity, Infinity">
                    <ListPanelWidget Name="SourceList" Direction="Vertical" Margin="3, 3" ItemSize="76" SelectionColor="10, 70, 0, 90" />
                </CanvasWidget>
                <LabelWidget Name="Warnings" Size="Infinity, 32" Margin="8, 0" FontScale="0.6" Color="210, 180, 100" WordWrap="true" IsVisible="false" />
            </StackPanelWidget>
            <LabelWidget Name="Status" WordWrap="true" Margin="10, 0" FontScale="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Color="160, 160, 160" />
        </CanvasWidget>
        <CanvasWidget Size="Infinity, 56" VerticalAlignment="Near" Margin="10, 2" Name="Filters" HorizontalAlignment="Stretch">
            <StackPanelWidget Direction="Horizontal">
                <CanvasWidget Size="Infinity, 56">
                    <CanvasWidget Margin="0, 6">
                        <BevelledRectangleWidget Style="{Styles/TextBoxArea}" />
                        <LabelWidget Name="SearchPlaceholder" Margin="10, 0" Color="128, 128, 128" Ellipsis="true" MaxLines="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="false"/>
                        <TextBoxWidget Name="Search" Size="Infinity, 48" Margin="10, 0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </CanvasWidget>
                </CanvasWidget>
                <SelectionDrawerWidget Name="RepositoryFilter" Size="230, 56" Margin="4, 0" MaxVisibleItems="5" />
                <CanvasWidget Size="160, 0" />
            </StackPanelWidget>
        </CanvasWidget>
        <ActionPanelWidget Name="Actions" Style="{Styles/ScreenActionPanel}" VerticalAlignment="Far" />
    </CanvasWidget>
</CanvasWidget>
