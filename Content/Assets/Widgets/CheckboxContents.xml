<CheckboxWidget xmlns="runtime-namespace:Game.Widgets" Margin="0, 6" Color="255, 255, 255" IsAutoCheckingEnabled="true"
                CheckboxSize="32, 32" TickSubtexture="{Textures/Atlas/Tick}">
    <StackPanelWidget Direction="Horizontal">
        <CanvasWidget Name="Checkbox.Canvas" VerticalAlignment="Center">
            <BevelledRectangleWidget Name="Checkbox.Rectangle" DirectionalLight="0" AmbientLight="1"
                                      BevelSize="1" RoundingRadius="4" ShadowColor="0, 0, 0, 0"/>
            <RectangleWidget Name="Checkbox.Tick" IsVisible="false" Margin="1, 1"/>
            <ClickableWidget Name="Checkbox.Clickable"/>
        </CanvasWidget>
        <LabelWidget Name="Checkbox.Label" Text="[CheckboxContents:1]" VerticalAlignment="Center" Margin="10, 0"/>
    </StackPanelWidget>
</CheckboxWidget>
