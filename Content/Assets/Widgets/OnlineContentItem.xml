<CanvasWidget xmlns="runtime-namespace:Game.Widgets" Size="Infinity, 100">
    <StackPanelWidget Direction="Horizontal" IsInverted="true" VerticalAlignment="Center" Margin="12, 4">
        <CanvasWidget Size="250, 92">
            <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far">
                <LabelWidget Name="OnlineContentItem.Details" Color="170, 170, 170" FontScale="0.55"
                             HorizontalAlignment="Far" TextAnchor="Right" Ellipsis="true" MaxLines="1"/>
                <LabelWidget Name="OnlineContentItem.Sources" Color="120, 160, 200" FontScale="0.5"
                             HorizontalAlignment="Far" TextAnchor="Right" Ellipsis="true" MaxLines="1"/>
            </StackPanelWidget>
        </CanvasWidget>
        <CanvasWidget Size="Infinity, 92">
            <StackPanelWidget Direction="Vertical" VerticalAlignment="Center">
                <LabelWidget Name="OnlineContentItem.Name" Color="255, 255, 255" FontScale="0.8"
                             Ellipsis="true" MaxLines="1"/>
                <LabelWidget Name="OnlineContentItem.Summary" Color="220, 220, 220" FontScale="0.55"
                             Ellipsis="true" MaxLines="1"/>
                <LabelWidget Name="OnlineContentItem.Identifier" Color="150, 150, 150" FontScale="0.5"
                             Ellipsis="true" MaxLines="1"/>
            </StackPanelWidget>
        </CanvasWidget>
    </StackPanelWidget>
</CanvasWidget>
