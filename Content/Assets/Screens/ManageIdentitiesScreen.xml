<Screen xmlns="runtime-namespace:Game.Widgets">
    <PanoramaWidget/>
    <StackPanelWidget Direction="Horizontal">
        <CanvasWidget Style="{Widgets/TopBarContents}"><LabelWidget Name="TopBar.Label" Text="[ManageIdentitiesScreen:Title]"/></CanvasWidget>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">
            <StackPanelWidget Style="{Styles/ScreenTopTabs}">
                <BevelledButtonWidget Name="PlayerTab" Text="[ManageIdentitiesScreen:Player]" Style="{Styles/ScreenTopTabButton}"/>
                <BevelledButtonWidget Name="ServerTab" Text="[ManageIdentitiesScreen:Server]" Style="{Styles/ScreenTopTabButton}"/>
            </StackPanelWidget>
            <CanvasWidget Style="{Styles/ScreenContentArea}">
                <BevelledRectangleWidget Style="{Styles/Area}"/>
                <ListPanelWidget Name="Identities" Direction="Vertical" Margin="3, 3" ItemSize="76" SelectionColor="10, 70, 0, 90"/>
            </CanvasWidget>
            <ActionPanelWidget Name="Actions" Style="{Styles/ScreenActionPanel}"/>
        </StackPanelWidget>
    </StackPanelWidget>
</Screen>
