<Screen xmlns="runtime-namespace:Game.Widgets">
    <PanoramaWidget/>
    <StackPanelWidget Direction="Horizontal">
        <CanvasWidget Style="{Widgets/TopBarContents}"><LabelWidget Name="TopBar.Label" Text="[ManageServicesScreen:Title]"/></CanvasWidget>
        <CanvasWidget>
            <StackPanelWidget Direction="Vertical">
                <StackPanelWidget Style="{Styles/ScreenTopTabs}">
                    <BevelledButtonWidget Name="ServerSource" Text="[Services:ServerSource]" Style="{Styles/ScreenTopTabButton}"/>
                    <BevelledButtonWidget Name="Rendezvous" Text="[Services:Rendezvous]" Style="{Styles/ScreenTopTabButton}"/>
                    <BevelledButtonWidget Name="Authentication" Text="[Services:Authentication]" Style="{Styles/ScreenTopTabButton}"/>
                </StackPanelWidget>
                <CanvasWidget Name="Panels"/>
            </StackPanelWidget>
        </CanvasWidget>
    </StackPanelWidget>
</Screen>
