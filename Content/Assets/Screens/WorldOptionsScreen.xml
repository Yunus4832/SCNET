<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[WorldOptionsScreen:1]"/>
        </CanvasWidget>

        <StackPanelWidget Direction="Vertical">

            <CanvasWidget Style="{Styles/ScreenContentArea}">
                <BevelledRectangleWidget Style="{Styles/Area}"/>
                <ScrollPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="3, 3">
                    <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!--New world only panel-->
                        <StackPanelWidget Name="NewWorldOnlyPanel" Direction="Vertical" HorizontalAlignment="Center">

                            <!--Terrain generation-->
                            <StackPanelWidget Name="TerrainGenerationPanel" Direction="Vertical">

                                <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                    <ClickableTextRowWidget Name="TerrainGenerationLabel"
                                                            Text="[WorldOptionsScreen:2]" Color="255, 255, 255"
                                                            HorizontalAlignment="Far" VerticalAlignment="Near"
                                                            TextHorizontalAlignment="Far" Margin="20, 0"/>
                                    <InlineSelectionWidget Name="TerrainGeneration" CollapsedSize="310, 60"
                                                           VerticalAlignment="Center" Margin="20, 0"
                                                           MaxVisibleItems="5"/>
                                </UniformSpacingPanelWidget>

                                <StackPanelWidget Name="ContinentTerrainPanel" Direction="Vertical"/>

                                <StackPanelWidget Name="IslandTerrainPanel" Direction="Vertical">
                                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                        <ClickableTextRowWidget Name="IslandSizeEWLabel"
                                                                Text="[WorldOptionsScreen:4]" Color="255, 255, 255"
                                                                HorizontalAlignment="Far" VerticalAlignment="Center"
                                                                TextHorizontalAlignment="Far" Margin="20, 0"/>
                                        <SliderWidget Name="IslandSizeEW" Size="Infinity, 60" VerticalAlignment="Center"
                                                      Margin="20, 0"/>
                                    </UniformSpacingPanelWidget>
                                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                        <ClickableTextRowWidget Name="IslandSizeNSLabel"
                                                                Text="[WorldOptionsScreen:5]" Color="255, 255, 255"
                                                                HorizontalAlignment="Far" VerticalAlignment="Center"
                                                                TextHorizontalAlignment="Far" Margin="20, 0"/>
                                        <SliderWidget Name="IslandSizeNS" Size="Infinity, 60" VerticalAlignment="Center"
                                                      Margin="20, 0"/>
                                    </UniformSpacingPanelWidget>
                                </StackPanelWidget>

                                <StackPanelWidget Name="FlatTerrainPanel" Direction="Vertical">

                                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                        <ClickableTextRowWidget Name="FlatTerrainLevelLabel"
                                                                Text="[WorldOptionsScreen:6]" Color="255, 255, 255"
                                                                HorizontalAlignment="Far" VerticalAlignment="Center"
                                                                TextHorizontalAlignment="Far" Margin="20, 0"/>
                                        <SliderWidget Name="FlatTerrainLevel" Size="Infinity, 60"
                                                      VerticalAlignment="Center" Margin="20, 0" Granularity="16"
                                                      MinValue="0" MaxValue="504"/>
                                    </UniformSpacingPanelWidget>

                                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                        <ClickableTextRowWidget Name="FlatTerrainShoreRoughnessLabel"
                                                                Text="[WorldOptionsScreen:7]" Color="255, 255, 255"
                                                                HorizontalAlignment="Far" VerticalAlignment="Center"
                                                                TextHorizontalAlignment="Far" Margin="20, 0"/>
                                        <SliderWidget Name="FlatTerrainShoreRoughness" Size="Infinity, 60"
                                                      VerticalAlignment="Center" Margin="20, 0" Granularity="0.1"
                                                      MinValue="0" MaxValue="1"/>
                                    </UniformSpacingPanelWidget>

                                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                        <ClickableTextRowWidget Name="FlatTerrainBlockSettingLabel"
                                                                Text="[WorldOptionsScreen:8]" Color="255, 255, 255"
                                                                HorizontalAlignment="Far" VerticalAlignment="Center"
                                                                TextHorizontalAlignment="Far" Margin="20, 0"/>
                                        <CanvasWidget Size="310, 60" VerticalAlignment="Center" Margin="20, 0">
                                            <CanvasWidget Margin="0, 6" IsHitTestVisible="false">
                                                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                                <StackPanelWidget Direction="Horizontal" Margin="12, 0">
                                                    <BlockIconWidget Name="FlatTerrainBlock" Size="48, 48"
                                                                     VerticalAlignment="Center" Contents="1"/>
                                                    <CanvasWidget Size="10, 0" IsHitTestVisible="false"/>
                                                    <LabelWidget Name="FlatTerrainBlockLabel"
                                                                 VerticalAlignment="Center"/>
                                                    <CanvasWidget Size="Infinity, 0" IsHitTestVisible="false"/>
                                                    <LabelWidget Text="..." Size="32, 48" Color="160, 160, 160"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 TextAnchor="HorizontalCenter, VerticalCenter"/>
                                                </StackPanelWidget>
                                            </CanvasWidget>
                                            <ClickableWidget Name="FlatTerrainBlockSelector"
                                                             SoundName="Audio/UI/ButtonClick"/>
                                        </CanvasWidget>
                                    </UniformSpacingPanelWidget>

                                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                        <ClickableTextRowWidget Name="MagmaOceanLabel"
                                                                Text="[WorldOptionsScreen:10]" Color="255, 255, 255"
                                                                HorizontalAlignment="Far" VerticalAlignment="Center"
                                                                TextHorizontalAlignment="Far" Margin="20, 0"/>
                                        <CheckboxWidget Name="MagmaOcean" VerticalAlignment="Center"
                                                        IsAutoCheckingEnabled="false" Margin="20, 14"/>
                                    </UniformSpacingPanelWidget>

                                </StackPanelWidget>

                            </StackPanelWidget>

                            <!-- Terrain options -->
                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="SeaLevelOffsetLabel" Text="[WorldOptionsScreen:11]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <SliderWidget Name="SeaLevelOffset" Size="Infinity, 60" VerticalAlignment="Center"
                                              Margin="20, 0" Granularity="1" MinValue="0" MaxValue="16"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="TemperatureOffsetLabel" Text="[WorldOptionsScreen:12]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <SliderWidget Name="TemperatureOffset" Size="Infinity, 60" VerticalAlignment="Center"
                                              Margin="20, 0" Granularity="2" MinValue="-16" MaxValue="16"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="HumidityOffsetLabel" Text="[WorldOptionsScreen:13]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <SliderWidget Name="HumidityOffset" Size="Infinity, 60" VerticalAlignment="Center"
                                              Margin="20, 0" Granularity="2" MinValue="-16" MaxValue="16"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="BiomeSizeLabel" Text="[WorldOptionsScreen:14]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <SliderWidget Name="BiomeSize" Size="Infinity, 60" VerticalAlignment="Center"
                                              Margin="20, 0" Granularity="2" MinValue="-16" MaxValue="16"/>
                            </UniformSpacingPanelWidget>

                        </StackPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <ClickableTextRowWidget Name="BlocksTextureSettingLabel" Text="[WorldOptionsScreen:15]"
                                                    Color="255, 255, 255" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                    Margin="20, 0"/>
                            <CanvasWidget Size="310, 60" VerticalAlignment="Center" Margin="20, 0">
                                <CanvasWidget Margin="0, 6" IsHitTestVisible="false">
                                    <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                    <StackPanelWidget Direction="Horizontal" Margin="12, 0">
                                        <RectangleWidget Name="BlocksTextureIcon" Size="48, 48"
                                                         FillColor="255, 255, 255"
                                                         OutlineColor="0, 0, 0, 0" VerticalAlignment="Center"/>
                                        <CanvasWidget Size="10, 0" IsHitTestVisible="false"/>
                                        <CanvasWidget Size="Infinity, 48" IsHitTestVisible="false">
                                            <StackPanelWidget Direction="Vertical" VerticalAlignment="Center"
                                                              IsHitTestVisible="false">
                                                <LabelWidget Name="BlocksTextureLabel"/>
                                                <LabelWidget Name="BlocksTextureDetails" Color="128, 128, 128"/>
                                            </StackPanelWidget>
                                        </CanvasWidget>
                                        <LabelWidget Text="..." Size="32, 48" Color="160, 160, 160"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     TextAnchor="HorizontalCenter, VerticalCenter"/>
                                    </StackPanelWidget>
                                </CanvasWidget>
                                <ClickableWidget Name="BlocksTextureSelector" SoundName="Audio/UI/ButtonClick"/>
                            </CanvasWidget>
                        </UniformSpacingPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <ClickableTextRowWidget Name="PaletteLabel" Text="[WorldOptionsScreen:17]"
                                                    Color="255, 255, 255" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                    Margin="20, 0"/>
                            <BevelledButtonWidget Name="Palette" Text="[WorldOptionsScreen:18]"
                                                  Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"
                                                  Margin="20, 0"/>
                        </UniformSpacingPanelWidget>

                        <!--Seasons panel-->
                        <StackPanelWidget Name="SeasonsPanel" Direction="Vertical" HorizontalAlignment="Center">

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="AreSeasonsChangingLabel" Text="[WorldOptionsScreen:26]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <CheckboxWidget Name="AreSeasonsChanging" VerticalAlignment="Center"
                                                IsAutoCheckingEnabled="false" Margin="20, 14"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Name="YearDaysPanel" Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="YearDaysLabel" Text="[WorldOptionsScreen:27]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <SliderWidget Name="YearDays" Size="Infinity, 60" VerticalAlignment="Center"
                                              Margin="20, 0"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="TimeOfYearLabel" Text="[WorldOptionsScreen:28]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <SliderWidget Name="TimeOfYear" Style="{Styles/SliderStyle_Seasons}" Size="Infinity, 60"
                                              VerticalAlignment="Center" Margin="20, 0" Granularity="0.01" MinValue="0"
                                              MaxValue="1"/>
                            </UniformSpacingPanelWidget>

                        </StackPanelWidget>

                        <!--Creative mode panel-->
                        <StackPanelWidget Name="CreativeModePanel" Direction="Vertical" HorizontalAlignment="Center">

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="EnvironmentBehaviorLabel" Text="[WorldOptionsScreen:19]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <BevelledButtonWidget Name="EnvironmentBehavior" Style="{Styles/ButtonStyle_310x60}"
                                                      VerticalAlignment="Center" Margin="20, 0"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="TimeOfDayLabel" Text="[WorldOptionsScreen:20]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Near" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <InlineSelectionWidget Name="TimeOfDay" CollapsedSize="310, 60"
                                                       VerticalAlignment="Center" Margin="20, 0"
                                                       MaxVisibleItems="5"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="WeatherEffectsLabel" Text="[WorldOptionsScreen:21]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <BevelledButtonWidget Name="WeatherEffects" Style="{Styles/ButtonStyle_310x60}"
                                                      VerticalAlignment="Center" Margin="20, 0"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="AdventureRespawnLabel" Text="[WorldOptionsScreen:22]"
                                                        Color="255, 255, 255" HorizontalAlignment="Far"
                                                        VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                        Margin="20, 0"/>
                                <BevelledButtonWidget Name="AdventureRespawn" Style="{Styles/ButtonStyle_310x60}"
                                                      VerticalAlignment="Center" Margin="20, 0"/>
                            </UniformSpacingPanelWidget>

                            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                                <ClickableTextRowWidget Name="AdventureSurvivalMechanicsLabel"
                                                        Text="[WorldOptionsScreen:23]" Color="255, 255, 255"
                                                        HorizontalAlignment="Far" VerticalAlignment="Center"
                                                        TextHorizontalAlignment="Far" Margin="20, 0"/>
                                <BevelledButtonWidget Name="AdventureSurvivalMechanics"
                                                      Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"
                                                      Margin="20, 0"/>
                            </UniformSpacingPanelWidget>

                        </StackPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <ClickableTextRowWidget Name="SupernaturalCreaturesLabel" Text="[WorldOptionsScreen:24]"
                                                    Color="255, 255, 255" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                    Margin="20, 0"/>
                            <BevelledButtonWidget Name="SupernaturalCreatures" Style="{Styles/ButtonStyle_310x60}"
                                                  VerticalAlignment="Center" Margin="20, 0"/>
                        </UniformSpacingPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <ClickableTextRowWidget Name="FriendlyFireLabel" Text="[WorldOptionsScreen:25]"
                                                    Color="255, 255, 255" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center" TextHorizontalAlignment="Far"
                                                    Margin="20, 0"/>
                            <BevelledButtonWidget Name="FriendlyFire" Style="{Styles/ButtonStyle_310x60}"
                                                  VerticalAlignment="Center" Margin="20, 0"/>
                        </UniformSpacingPanelWidget>

                    </StackPanelWidget>
                </ScrollPanelWidget>
            </CanvasWidget>

            <CanvasWidget Style="{Styles/ScreenDescriptionArea}">
                <LabelWidget Name="Description" Color="128, 128, 128" FontScale="0.8" HorizontalAlignment="Center"
                             VerticalAlignment="Center" TextAnchor="HorizontalCenter, VerticalCenter" WordWrap="true"/>
            </CanvasWidget>

        </StackPanelWidget>

    </StackPanelWidget>

</Screen>
