<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[SettingsDiagnosticsScreen:0]"/>
        </CanvasWidget>

        <CanvasWidget Style="{Styles/ScreenContentArea}">
            <BevelledRectangleWidget Style="{Styles/Area}"/>
            <ScrollPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="3, 3">
                <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsDiagnosticsScreen:1]" HorizontalAlignment="Far"
                                     VerticalAlignment="Center" Margin="20, 0"/>
                        <BevelledButtonWidget Name="DisplayDebugInfoButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsDiagnosticsScreen:2]" HorizontalAlignment="Far"
                                     VerticalAlignment="Center" Margin="20, 0"/>
                        <BevelledButtonWidget Name="DisplayFpsRibbonButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsDiagnosticsScreen:3]" HorizontalAlignment="Far"
                                     VerticalAlignment="Center" Margin="20, 0"/>
                        <BevelledButtonWidget Name="ViewGameLogButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"
                                              Text="[SettingsDiagnosticsScreen:4]"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsDiagnosticsScreen:5]" HorizontalAlignment="Far"
                                     VerticalAlignment="Center" Margin="20, 0"/>
                        <BevelledButtonWidget Name="UseReducedZRangeButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsDiagnosticsScreen:6]" HorizontalAlignment="Far"
                                     VerticalAlignment="Center" Margin="20, 0"/>
                        <BevelledButtonWidget Name="ResetCompatibilityButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"
                                              Text="[SettingsDiagnosticsScreen:7]"/>
                    </UniformSpacingPanelWidget>

                </StackPanelWidget>
            </ScrollPanelWidget>
        </CanvasWidget>
    </StackPanelWidget>

</Screen>
