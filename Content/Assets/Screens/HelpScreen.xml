<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[HelpScreen:1]"/>
        </CanvasWidget>

        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">

            <StackPanelWidget Direction="Vertical">
                <CanvasWidget Style="{Styles/ScreenContentArea}">
                    <BevelledRectangleWidget Style="{Styles/Area}"/>
                    <ListPanelWidget Name="TopicsList" Direction="Vertical" Margin="3, 3" ItemSize="56"
                                     SelectionColor="10, 70, 0, 90"/>
                </CanvasWidget>
            </StackPanelWidget>

            <StackPanelWidget Style="{Styles/ScreenBottomActions}">
                <BevelledButtonWidget Name="BestiaryButton" Style="{Styles/ButtonStyle_310x60}" Size="310, 56"
                                      Text="[HelpScreen:2]">
                    <BevelledRectangleWidget Name="BevelledButton.Rectangle" CenterColor="120, 65, 30"
                                             BevelColor="120, 65, 30"/>
                </BevelledButtonWidget>
                <CanvasWidget Size="8, 0"/>
                <BevelledButtonWidget Name="RecipaediaButton" Style="{Styles/ButtonStyle_310x60}" Size="310, 56"
                                      Text="[HelpScreen:3]">
                    <BevelledRectangleWidget Name="BevelledButton.Rectangle" CenterColor="50, 150, 35"
                                             BevelColor="50, 150, 35"/>
                </BevelledButtonWidget>
            </StackPanelWidget>

        </StackPanelWidget>

    </StackPanelWidget>

</Screen>
