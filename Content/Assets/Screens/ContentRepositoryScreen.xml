<Screen xmlns="runtime-namespace:Game.Widgets">
    <PanoramaWidget/>
    <StackPanelWidget Direction="Horizontal">
        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[ContentRepositoryScreen:Title]"/>
        </CanvasWidget>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">
            <CanvasWidget Size="0, 20"/>
            <CanvasWidget Margin="20, 0">
                <BevelledRectangleWidget Style="{Styles/Area}"/>
                <ListPanelWidget Name="RepositoryList" Direction="Vertical" Margin="5, 3" ItemSize="76"
                                 SelectionColor="10, 70, 0, 90"/>
                <LabelWidget Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Color="160, 160, 160"/>
            </CanvasWidget>
            <CanvasWidget Size="0, 10"/>
            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center">
                <BevelledButtonWidget Name="Add" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ContentRepositoryScreen:Add]"/>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Edit" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ContentRepositoryScreen:Edit]"/>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Delete" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ContentRepositoryScreen:Delete]"/>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Toggle" Style="{Styles/ButtonStyle_160x60}"/>
            </StackPanelWidget>
            <CanvasWidget Size="0, 8"/>
            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center">
                <BevelledButtonWidget Name="MoveUp" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ContentRepositoryScreen:MoveUp]"/>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="MoveDown" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ContentRepositoryScreen:MoveDown]"/>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Test" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ContentRepositoryScreen:Test]"/>
            </StackPanelWidget>
            <CanvasWidget Size="0, 10"/>
        </StackPanelWidget>
    </StackPanelWidget>
</Screen>
