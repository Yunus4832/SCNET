<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[ModifyWorldScreen:0]"/>
        </CanvasWidget>
        <ScrollPanelWidget Direction="Vertical">
            <CanvasWidget HorizontalAlignment="Near" Size="Infinity,1000">
                <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near"
                                  Margin="10, 10">
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:1]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <TextBoxWidget Name="Name" Title="重命名世界" Size="320, 50" VerticalAlignment="Center"
                                           MaximumLength="14" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:10]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <CheckboxWidget Name="RunServer" Size="50, 50" VerticalAlignment="Center" Color="255, 0, 0"
                                            Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Name="LoginConfig">
                        <LabelWidget Title="需要登录社区" HorizontalAlignment="Far" VerticalAlignment="Center"
                                     Text="[ModifyWorldScreen:13]" Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <CheckboxWidget Name="NeedLogin" Size="50, 50" VerticalAlignment="Center" Color="255, 0, 0"
                                            Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Name="ServerConfig"
                                               IsVisible="False">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:11]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <TextBoxWidget Name="Password" Title="[ModifyWorldScreen:17]" Size="380, 50"
                                           VerticalAlignment="Center" MaximumLength="16" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center"
                                               Name="KeywordBlockingConfig" IsVisible="False">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:15]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <TextBoxWidget Name="KeywordBlocking" Title="[ModifyWorldScreen:16]" Size="380, 50"
                                           VerticalAlignment="Center" MaximumLength="16" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Name="MaxPlayerConfig"
                                               IsVisible="False">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:12]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <TextBoxWidget Name="MaxPlayers" Title="[ModifyWorldScreen:18]" Size="380, 50" Text="20"
                                           VerticalAlignment="Center" MaximumLength="16" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Name="DaySpeedConfig"
                                               IsVisible="False">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="一天时间长度系数"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <TextBoxWidget Name="DaySpeed" Title="一天时间长度系数" Size="380, 50"
                                           VerticalAlignment="Center" MaximumLength="16" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center"
                                               Name="RecoverySpeedConfig" IsVisible="False">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="睡觉属性恢复系数"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <TextBoxWidget Name="RecoverySpeed" Title="睡觉属性恢复系数" Size="380, 50"
                                           VerticalAlignment="Center" MaximumLength="16" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center"
                                               Name="DisableBlocksPanel" IsVisible="False">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[NewWorldScreen:15]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <TextBoxWidget Name="DisableBlocks" Title="[ModifyWorldScreen:19]" Size="380, 50"
                                           VerticalAlignment="Center" MaximumLength="16" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center"
                                               Name="RandomSpawnPositionPanel">
                        <LabelWidget HorizontalAlignment="Far" Title="随机出生点" VerticalAlignment="Center"
                                     Text="[NewWorldScreen:16]" Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <CheckboxWidget Name="RandomSpawnPosition" Size="50, 50" VerticalAlignment="Center"
                                            Color="255, 0, 0" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:2]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <LabelWidget Name="Seed" VerticalAlignment="Center" Margin="10, 0" Color="128, 128, 128"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:3]"
                                     Margin="10, 0"/>
                        <BevelledButtonWidget Name="GameMode" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="5, 0"/>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:4]"
                                     Margin="10, 0"/>
                        <BevelledButtonWidget Name="WorldOptions" Style="{Styles/ButtonStyle_310x60}"
                                              Text="[ModifyWorldScreen:5]" VerticalAlignment="Center" Margin="5, 0"/>
                    </UniformSpacingPanelWidget>
                    <CanvasWidget HorizontalAlignment="Center">
                        <LabelWidget Name="Error" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Text="[ModifyWorldScreen:6]" Color="255, 0, 0"/>
                        <LabelWidget Name="Description" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     TextAnchor="HorizontalCenter, VerticalCenter" Color="128, 128, 128" WordWrap="true"
                                     Margin="10, 0"/>
                    </CanvasWidget>
                    <StackPanelWidget HorizontalAlignment="Center" VerticalAlignment="Far">
                        <BevelledButtonWidget Name="Delete" Style="{Styles/ButtonStyle_160x60}"
                                              Text="[ModifyWorldScreen:7]" Margin="6, 0"/>
                        <BevelledButtonWidget Name="Upload" Style="{Styles/ButtonStyle_160x60}"
                                              Text="[ModifyWorldScreen:8]" Margin="6, 0"/>
                        <CanvasWidget Size="Infinity, 0"/>
                        <BevelledButtonWidget Name="Apply" Style="{Styles/ButtonStyle_310x60}"
                                              Text="[ModifyWorldScreen:9]" Margin="6, 0"/>
                    </StackPanelWidget>
                </StackPanelWidget>
            </CanvasWidget>
        </ScrollPanelWidget>
    </StackPanelWidget>

</Screen>
