<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[ModifyWorldScreen:0]"/>
        </CanvasWidget>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">
            <CanvasWidget Style="{Styles/ScreenContentArea}" Size="Infinity, Infinity">
                <BevelledRectangleWidget Style="{Styles/Area}"/>
                <ScrollPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="3, 3">
                    <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <LabelWidget Text="[ModifyWorldScreen:1]" HorizontalAlignment="Far"
                                         VerticalAlignment="Center" TextAnchor="Right" Margin="20, 0"/>
                            <CanvasWidget Size="310, 50" VerticalAlignment="Center" Margin="20, 5">
                                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                <TextBoxWidget Name="Name" Size="310, 50" VerticalAlignment="Center"
                                               MaximumLength="14" Margin="10, 0"/>
                            </CanvasWidget>
                        </UniformSpacingPanelWidget>
                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <LabelWidget Text="[ModifyWorldScreen:2]" HorizontalAlignment="Far"
                                         VerticalAlignment="Center" TextAnchor="Right" Margin="20, 0"/>
                            <CanvasWidget Size="310, 50" VerticalAlignment="Center" Margin="20, 5">
                                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                <LabelWidget Name="Seed" VerticalAlignment="Center" Margin="10, 0"
                                             Color="128, 128, 128"/>
                            </CanvasWidget>
                        </UniformSpacingPanelWidget>
                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <LabelWidget Text="[ModifyWorldScreen:3]" HorizontalAlignment="Far"
                                         VerticalAlignment="Center" TextAnchor="Right" Margin="20, 0"/>
                            <BevelledButtonWidget Name="GameMode" Style="{Styles/ButtonStyle_310x60}"
                                                  VerticalAlignment="Center" Margin="20, 0"/>
                        </UniformSpacingPanelWidget>
                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <LabelWidget Text="[ModifyWorldScreen:4]" HorizontalAlignment="Far"
                                         VerticalAlignment="Center" TextAnchor="Right" Margin="20, 0"/>
                            <BevelledButtonWidget Name="WorldOptions" Style="{Styles/ButtonStyle_310x60}"
                                                  Text="[ModifyWorldScreen:5]" VerticalAlignment="Center"
                                                  Margin="20, 0"/>
                        </UniformSpacingPanelWidget>
                        <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                            <LabelWidget Text="[NewWorldScreen:22]" HorizontalAlignment="Far"
                                         VerticalAlignment="Center" TextAnchor="Right" Margin="20, 0"/>
                            <BevelledButtonWidget Name="ServerSettings" Style="{Styles/ButtonStyle_310x60}"
                                                  Text="[NewWorldScreen:22]" VerticalAlignment="Center"
                                                  Margin="20, 0"/>
                        </UniformSpacingPanelWidget>
                    </StackPanelWidget>
                </ScrollPanelWidget>
            </CanvasWidget>
            <LabelWidget Name="Error" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="[ModifyWorldScreen:6]" Color="255, 0, 0" Margin="0, 2"/>
            <StackPanelWidget Style="{Styles/ScreenBottomActions}">
                <BevelledButtonWidget Name="Apply" Style="{Styles/ButtonStyle_310x60}"
                                      Text="[ModifyWorldScreen:8]" Margin="6, 0">
                    <BevelledRectangleWidget Name="BevelledButton.Rectangle" CenterColor="50, 150, 35"
                                             BevelColor="50, 150, 35"/>
                </BevelledButtonWidget>
            </StackPanelWidget>
        </StackPanelWidget>
    </StackPanelWidget>

</Screen>
