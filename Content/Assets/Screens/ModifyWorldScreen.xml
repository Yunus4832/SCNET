<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[ModifyWorldScreen:0]"/>
        </CanvasWidget>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">
            <CanvasWidget Size="Infinity, Infinity">
                <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="10, 0">
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:1]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <TextBoxWidget Name="Name" Size="320, 50" VerticalAlignment="Center"
                                           MaximumLength="14" Margin="10, 0"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:2]"
                                     Margin="10, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="9, 5">
                            <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="128, 128, 128, 128"/>
                            <LabelWidget Name="Seed" VerticalAlignment="Center" Margin="10, 0" Color="128, 128, 128"/>
                        </CanvasWidget>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:3]"
                                     Margin="10, 0"/>
                        <BevelledButtonWidget Name="GameMode" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="5, 0"/>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[ModifyWorldScreen:4]"
                                     Margin="10, 0"/>
                        <BevelledButtonWidget Name="WorldOptions" Style="{Styles/ButtonStyle_310x60}"
                                              Text="[ModifyWorldScreen:5]" VerticalAlignment="Center" Margin="5, 0"/>
                    </UniformSpacingPanelWidget>
                    <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center">
                        <LabelWidget HorizontalAlignment="Far" VerticalAlignment="Center" Text="[NewWorldScreen:22]"
                                     Margin="10, 0"/>
                        <BevelledButtonWidget Name="ServerSettings" Style="{Styles/ButtonStyle_310x60}"
                                              Text="[NewWorldScreen:22]" VerticalAlignment="Center" Margin="5, 0"/>
                    </UniformSpacingPanelWidget>
                </StackPanelWidget>
            </CanvasWidget>
            <CanvasWidget HorizontalAlignment="Center" Size="Infinity, 48" Margin="0, 4">
                <LabelWidget Name="Error" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Text="[ModifyWorldScreen:6]" Color="255, 0, 0"/>
            </CanvasWidget>
            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="0, 8">
                <BevelledButtonWidget Name="Delete" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ModifyWorldScreen:7]" Margin="6, 0"/>
                <CanvasWidget Size="Infinity, 0"/>
                <BevelledButtonWidget Name="Apply" Style="{Styles/ButtonStyle_310x60}"
                                      Text="[ModifyWorldScreen:8]" Margin="6, 0"/>
            </StackPanelWidget>
        </StackPanelWidget>
    </StackPanelWidget>

</Screen>
