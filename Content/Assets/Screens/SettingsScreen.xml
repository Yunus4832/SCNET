<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[SettingsScreen:1]"/>
        </CanvasWidget>

        <CanvasWidget Style="{Styles/ScreenContentArea}" ClampToBounds="true">
            <BevelledRectangleWidget Style="{Styles/Area}"/>
            <ScrollPanelWidget Direction="Vertical" Margin="5, 5">
                <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <StackPanelWidget Direction="Horizontal">
                        <CanvasWidget Size="350, 90">
                            <LabelWidget Text="[SettingsScreen:PerformanceDescription]" Color="128, 128, 128"
                                         WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                         TextAnchor="VerticalCenter, HorizontalCenter"/>
                        </CanvasWidget>
                        <CanvasWidget Size="10, 0"/>
                        <BevelledButtonWidget Name="Performance" Text="[SettingsScreen:2]"
                                              Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
                    </StackPanelWidget>

                    <StackPanelWidget Direction="Horizontal">
                        <CanvasWidget Size="350, 90">
                            <LabelWidget Text="[SettingsScreen:GraphicsDescription]" Color="128, 128, 128"
                                         WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                         TextAnchor="VerticalCenter, HorizontalCenter"/>
                        </CanvasWidget>
                        <CanvasWidget Size="10, 0"/>
                        <BevelledButtonWidget Name="Graphics" Text="[SettingsScreen:3]"
                                              Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
                    </StackPanelWidget>

                    <StackPanelWidget Direction="Horizontal">
                        <CanvasWidget Size="350, 90">
                            <LabelWidget Text="[SettingsScreen:UiDescription]" Color="128, 128, 128"
                                         WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                         TextAnchor="VerticalCenter, HorizontalCenter"/>
                        </CanvasWidget>
                        <CanvasWidget Size="10, 0"/>
                        <BevelledButtonWidget Name="Ui" Text="[SettingsScreen:4]"
                                              Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
                    </StackPanelWidget>

                    <StackPanelWidget Direction="Horizontal">
                        <CanvasWidget Size="350, 90">
                            <LabelWidget Text="[SettingsScreen:AudioDescription]" Color="128, 128, 128"
                                         WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                         TextAnchor="VerticalCenter, HorizontalCenter"/>
                        </CanvasWidget>
                        <CanvasWidget Size="10, 0"/>
                        <BevelledButtonWidget Name="Audio" Text="[SettingsScreen:5]"
                                              Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
                    </StackPanelWidget>

                    <StackPanelWidget Direction="Horizontal">
                        <CanvasWidget Size="350, 90">
                            <LabelWidget Text="[SettingsScreen:ControlsDescription]" Color="128, 128, 128"
                                         WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                         TextAnchor="VerticalCenter, HorizontalCenter"/>
                        </CanvasWidget>
                        <CanvasWidget Size="10, 0"/>
                        <BevelledButtonWidget Name="Controls" Text="[SettingsScreen:6]"
                                              Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
                    </StackPanelWidget>

                    <StackPanelWidget Direction="Horizontal">
                        <CanvasWidget Size="350, 90">
                            <LabelWidget Text="[SettingsScreen:DiagnosticsDescription]" Color="128, 128, 128"
                                         WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                         TextAnchor="VerticalCenter, HorizontalCenter"/>
                        </CanvasWidget>
                        <CanvasWidget Size="10, 0"/>
                        <BevelledButtonWidget Name="Diagnostics" Text="[SettingsScreen:7]"
                                              Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
                    </StackPanelWidget>

                </StackPanelWidget>
            </ScrollPanelWidget>
        </CanvasWidget>

    </StackPanelWidget>

</Screen>
