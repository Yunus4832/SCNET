<Screen xmlns="runtime-namespace:Game.Widgets">
    <PanoramaWidget/>
    <StackPanelWidget Direction="Horizontal">
        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[ManageAuthenticationScreen:Title]"/>
        </CanvasWidget>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">
            <CanvasWidget Style="{Styles/ScreenContentArea}">
                <BevelledRectangleWidget Style="{Styles/Area}"/>
                <ListPanelWidget Name="Services" Direction="Vertical" Margin="3, 3" ItemSize="76" SelectionColor="10, 70, 0, 90"/>
                <LabelWidget Name="Empty" Text="[ManageAuthenticationScreen:Empty]" FontScale="0.85" Color="160, 160, 160" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </CanvasWidget>
            <CanvasWidget Style="{Styles/ScreenDescriptionArea}">
                <LabelWidget Name="Status" WordWrap="true" FontScale="0.65" TextAnchor="HorizontalCenter, VerticalCenter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </CanvasWidget>
            <ActionPanelWidget Name="Actions" Style="{Styles/ScreenActionPanel}"/>
        </StackPanelWidget>
    </StackPanelWidget>
</Screen>
