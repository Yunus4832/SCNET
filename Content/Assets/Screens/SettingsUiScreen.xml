<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[SettingsUiScreen:0]"/>
        </CanvasWidget>

        <CanvasWidget Style="{Styles/ScreenContentArea}">
            <BevelledRectangleWidget Style="{Styles/Area}"/>
            <ScrollPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="3, 3">
                <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <CanvasWidget Size="310, 60" HorizontalAlignment="Far" VerticalAlignment="Near"
                                      Margin="20, 0">
                            <LabelWidget Text="[SettingsUiScreen:1]" HorizontalAlignment="Far"
                                         VerticalAlignment="Center"/>
                        </CanvasWidget>
                        <InlineSelectionWidget Name="LanguageSelection" CollapsedSize="310, 60"
                                               VerticalAlignment="Near" Margin="20, 0" MaxVisibleItems="4"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Name="WindowModeContainer" Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:2]" HorizontalAlignment="Far" VerticalAlignment="Center"
                                     Margin="20, 0"/>
                        <BevelledButtonWidget Name="WindowModeButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:3]" HorizontalAlignment="Far" VerticalAlignment="Center"
                                     Margin="20, 0"/>
                        <SliderWidget Name="UIScaleSlider" Size="410, 60" VerticalAlignment="Center"
                                      Granularity="0.05" MinValue="0.5" MaxValue="1.2" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:4]" HorizontalAlignment="Far" VerticalAlignment="Center"
                                     Margin="20, 0"/>
                        <BevelledButtonWidget Name="UpsideDownButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <CanvasWidget Size="0, 12"/>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:8]" HorizontalAlignment="Far"
                                     VerticalAlignment="Center" Margin="20, 0"/>
                        <BevelledButtonWidget Name="HudSafeArea" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:10]" HorizontalAlignment="Far"
                                     VerticalAlignment="Center" Margin="20, 0"/>
                        <BevelledButtonWidget Name="HudSafeAreaCustomPadding" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:9]" HorizontalAlignment="Far"
                                     VerticalAlignment="Center" Margin="20, 0"/>
                        <SliderWidget Name="HudSafeAreaPadding" Size="410, 60" VerticalAlignment="Center"
                                      Margin="20, 0" MinValue="0" MaxValue="80" Granularity="4"/>
                    </UniformSpacingPanelWidget>

                    <CanvasWidget Size="0, 12"/>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:5]" HorizontalAlignment="Far" VerticalAlignment="Center"
                                     Margin="20, 0"/>
                        <BevelledButtonWidget Name="ShowGuiInScreenshotsButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:6]" HorizontalAlignment="Far" VerticalAlignment="Center"
                                     Margin="20, 0"/>
                        <BevelledButtonWidget Name="ShowLogoInScreenshotsButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                    <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Text="[SettingsUiScreen:7]" HorizontalAlignment="Far" VerticalAlignment="Center"
                                     Margin="20, 0"/>
                        <BevelledButtonWidget Name="ScreenshotSizeButton" Style="{Styles/ButtonStyle_310x60}"
                                              VerticalAlignment="Center" Margin="20, 0"/>
                    </UniformSpacingPanelWidget>

                </StackPanelWidget>
            </ScrollPanelWidget>
        </CanvasWidget>

    </StackPanelWidget>

</Screen>
