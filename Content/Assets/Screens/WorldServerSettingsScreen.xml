<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[WorldServerSettingsScreen:Title]"/>
        </CanvasWidget>

        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" Margin="10, 10">

            <CanvasWidget Size="Infinity, Infinity">
                <BevelledRectangleWidget Style="{Styles/Area}"/>
                <ScrollPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="3, 3">
                    <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="10, 10">

                        <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Margin="0, 3">
                            <ClickableTextRowWidget Name="RunServerLabel" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center"
                                                    Text="[WorldServerSettingsScreen:RunServer]"
                                                    TextHorizontalAlignment="Far" Color="255, 255, 255"
                                                    Margin="20, 0"/>
                            <CheckboxWidget Name="RunServer" VerticalAlignment="Center" Margin="20, 14"/>
                        </UniformSpacingPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Margin="0, 3">
                            <ClickableTextRowWidget Name="MaxPlayersLabel" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center"
                                                    Text="[WorldServerSettingsScreen:MaxPlayers]"
                                                    TextHorizontalAlignment="Far" Color="255, 255, 255"
                                                    Margin="20, 0"/>
                            <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="20, 5">
                                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                <TextBoxWidget Name="MaxPlayers" Size="380, 50" Text="20" VerticalAlignment="Center"
                                               MaximumLength="16" Margin="10, 0"/>
                            </CanvasWidget>
                        </UniformSpacingPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Margin="0, 3">
                            <ClickableTextRowWidget Name="DaySpeedLabel" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center"
                                                    Text="[WorldServerSettingsScreen:DaySpeed]"
                                                    TextHorizontalAlignment="Far" Color="255, 255, 255"
                                                    Margin="20, 0"/>
                            <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="20, 5">
                                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                <TextBoxWidget Name="DaySpeed" Size="380, 50" VerticalAlignment="Center"
                                               MaximumLength="16" Margin="10, 0"/>
                            </CanvasWidget>
                        </UniformSpacingPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Margin="0, 3">
                            <ClickableTextRowWidget Name="RecoverySpeedLabel" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center"
                                                    Text="[WorldServerSettingsScreen:RecoverySpeed]"
                                                    TextHorizontalAlignment="Far" Color="255, 255, 255"
                                                    Margin="20, 0"/>
                            <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="20, 5">
                                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                <TextBoxWidget Name="RecoverySpeed" Size="380, 50" VerticalAlignment="Center"
                                               MaximumLength="16" Margin="10, 0"/>
                            </CanvasWidget>
                        </UniformSpacingPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Margin="0, 3">
                            <ClickableTextRowWidget Name="DisableBlocksLabel" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center"
                                                    Text="[WorldServerSettingsScreen:DisableBlocks]"
                                                    TextHorizontalAlignment="Far" Color="255, 255, 255"
                                                    Margin="20, 0"/>
                            <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="20, 5">
                                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                <TextBoxWidget Name="DisableBlocks" Size="380, 50" VerticalAlignment="Center"
                                               MaximumLength="16" Margin="10, 0"/>
                            </CanvasWidget>
                        </UniformSpacingPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Margin="0, 3">
                            <ClickableTextRowWidget Name="RandomSpawnPositionLabel" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center"
                                                    Text="[WorldServerSettingsScreen:RandomSpawnPosition]"
                                                    TextHorizontalAlignment="Far" Color="255, 255, 255"
                                                    Margin="20, 0"/>
                            <CheckboxWidget Name="RandomSpawnPosition" VerticalAlignment="Center" Margin="20, 14"/>
                        </UniformSpacingPanelWidget>

                        <UniformSpacingPanelWidget Direction="Horizontal" VerticalAlignment="Center" Margin="0, 3">
                            <ClickableTextRowWidget Name="KeywordBlockingLabel" HorizontalAlignment="Far"
                                                    VerticalAlignment="Center"
                                                    Text="[WorldServerSettingsScreen:KeywordBlocking]"
                                                    TextHorizontalAlignment="Far" Color="255, 255, 255"
                                                    Margin="20, 0"/>
                            <CanvasWidget VerticalAlignment="Center" Size="Infinity, 50" Margin="20, 5">
                                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                                <TextBoxWidget Name="KeywordBlocking" Size="380, 50" VerticalAlignment="Center"
                                               MaximumLength="16" Margin="10, 0"/>
                            </CanvasWidget>
                        </UniformSpacingPanelWidget>

                    </StackPanelWidget>
                </ScrollPanelWidget>
            </CanvasWidget>

            <CanvasWidget Style="{Styles/ScreenDescriptionArea}" HorizontalAlignment="Center">
                <LabelWidget Name="Description" Color="128, 128, 128" FontScale="0.8" HorizontalAlignment="Center"
                             VerticalAlignment="Center" WordWrap="true" TextAnchor="HorizontalCenter, VerticalCenter"
                             Margin="10, 0"/>
            </CanvasWidget>

        </StackPanelWidget>

    </StackPanelWidget>

</Screen>
