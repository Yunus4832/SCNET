<CanvasWidget xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[CharacterScreen:1]"/>
        </CanvasWidget>

        <CanvasWidget Size="Infinity, Infinity">
            <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near"
                              Margin="10, 10">

            <StackPanelWidget Direction="Horizontal">

                <CanvasWidget Size="150, 350">
                    <CharacterModelWidget Name="Model" CanvasWidget.Position="30, 0" AnimateHeadSeed="1"
                                       AnimateHandsSeed="1" VerticalAlignment="Center" IsHitTestVisible="true"/>
                </CanvasWidget>

                <StackPanelWidget Direction="Vertical" ClampToBounds="true">

                    <StackPanelWidget Direction="Horizontal" Margin="0, 3">
                        <ClickableTextRowWidget Name="CharacterSexLabel" Size="170, 60" Text="[CharacterScreen:2]"
                                                TextHorizontalAlignment="Far" VerticalAlignment="Center"/>
                        <CanvasWidget Size="50, 0"/>
                        <BevelledButtonWidget Name="CharacterSexButton" Style="{Styles/ButtonStyle_310x60}"
                                              Size="330, 60" VerticalAlignment="Center"/>
                    </StackPanelWidget>

                    <StackPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Size="170, -1" Text="[CharacterScreen:3]" TextAnchor="Right"
                                     VerticalAlignment="Center"/>
                        <CanvasWidget Size="50, 0"/>
                        <CanvasWidget VerticalAlignment="Center" Size="330, 50" Margin="0, 7">
                            <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                            <TextBoxWidget Name="Name" Size="330, 50"
                                           VerticalAlignment="Center" MaximumLength="14" Margin="10, 0"/>
                        </CanvasWidget>
                    </StackPanelWidget>

                    <StackPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Size="170, -1" Text="[CharacterScreen:4]" TextAnchor="Right"
                                     VerticalAlignment="Center"/>
                        <CanvasWidget Size="50, 0"/>
                        <CanvasWidget Size="330, 50" VerticalAlignment="Center" Margin="0, 5">
                            <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                            <LabelWidget Name="CharacterSkinLabel" HorizontalAlignment="Near"
                                         VerticalAlignment="Center" Margin="5, 0"/>
                            <ClickableWidget Name="CharacterSkinSelector" SoundName="Audio/UI/ButtonClick"/>
                        </CanvasWidget>
                    </StackPanelWidget>

                    <StackPanelWidget Direction="Horizontal" Margin="0, 3">
                        <LabelWidget Size="170, -1" Text="[CharacterScreen:6]" TextAnchor="Right"
                                     VerticalAlignment="Center"/>
                        <CanvasWidget Size="50, 0"/>
                        <SelectionDrawerWidget Name="Controls" Size="330, 50" Margin="0, 5"
                                               ExpansionDirection="Down" MaxVisibleItems="4"
                                               SurfaceMargin="0" HeaderHorizontalAlignment="Center"
                                               HeaderContentMargin="0, 0"/>
                    </StackPanelWidget>

                    <CanvasWidget Size="550, -1" HorizontalAlignment="Center">
                        <LabelWidget Name="DescriptionLabel" Color="128, 128, 128" FontScale="0.8"
                                     HorizontalAlignment="Center" TextAnchor="HorizontalCenter" WordWrap="true"
                                     Margin="10, 20"/>
                    </CanvasWidget>

                </StackPanelWidget>
            </StackPanelWidget>

            <CanvasWidget Size="0, Infinity"/>

            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center">
                <BevelledButtonWidget Name="PlayButton" Style="{Styles/ButtonStyle_310x60}" Text="[CharacterScreen:10]"
                                      VerticalAlignment="Far" HorizontalAlignment="Center" Margin="20, 0">
                    <BevelledRectangleWidget Name="BevelledButton.Rectangle" CenterColor="50, 150, 35"
                                             BevelColor="50, 150, 35"/>
                </BevelledButtonWidget>
            </StackPanelWidget>

            </StackPanelWidget>
        </CanvasWidget>
    </StackPanelWidget>

    <!--So that model widgets on top of the screen work-->
    <ClearWidget ClearColor="false" ClearDepth="true" Depth="1"/>

</CanvasWidget>
