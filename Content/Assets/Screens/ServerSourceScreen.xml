<Screen xmlns="runtime-namespace:Game.Widgets">
    <PanoramaWidget/>
    <StackPanelWidget Direction="Horizontal">
        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[ServerSourceScreen:Title]"/>
        </CanvasWidget>
        <CanvasWidget>
            <CanvasWidget Margin="10, 66">
                <BevelledRectangleWidget Style="{Styles/Area}"/>
                <ListPanelWidget Name="SourceList" Direction="Vertical" Margin="3, 3" ItemSize="76"
                                 SelectionColor="10, 70, 0, 90"/>
                <LabelWidget Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Color="160, 160, 160"/>
            </CanvasWidget>
            <CanvasWidget Size="Infinity, 56" VerticalAlignment="Near" Margin="10, 2">
                <StackPanelWidget Direction="Horizontal">
                    <CanvasWidget Size="Infinity, 56">
                        <CanvasWidget Margin="0, 6">
                            <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                            <LabelWidget Name="SearchPlaceholder" Margin="10, 0" Color="128, 128, 128"
                                         VerticalAlignment="Center" IsHitTestVisible="false"/>
                            <TextBoxWidget Name="Search" Size="Infinity, 48" Margin="10, 0"
                                           VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </CanvasWidget>
                    </CanvasWidget>
                    <SelectionDrawerWidget Name="RepositoryFilter" Size="230, 56" Margin="4, 0"
                                           MaxVisibleItems="5"/>
                </StackPanelWidget>
            </CanvasWidget>
            <ActionPanelWidget Name="Actions" Style="{Styles/ScreenActionPanel}" VerticalAlignment="Far"/>
        </CanvasWidget>
    </StackPanelWidget>
</Screen>
