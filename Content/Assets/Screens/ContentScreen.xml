<Screen xmlns="runtime-namespace:Game.Widgets">

    <PanoramaWidget/>

    <StackPanelWidget Direction="Horizontal">

        <CanvasWidget Style="{Widgets/TopBarContents}">
            <LabelWidget Name="TopBar.Label" Text="[ContentScreen:1]"/>
        </CanvasWidget>

        <CanvasWidget Style="{Styles/ScreenContentArea}" ClampToBounds="true">
            <BevelledRectangleWidget Style="{Styles/Area}"/>
            <ScrollPanelWidget Direction="Vertical" Margin="5, 5">
                <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanelWidget Direction="Horizontal">
                <CanvasWidget Size="350, 90">
                    <LabelWidget Text="[ContentScreen:RepositoriesDescription]" Color="128, 128, 128"
                                 WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                 TextAnchor="VerticalCenter, HorizontalCenter"/>
                </CanvasWidget>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Repositories" Text="[ContentScreen:Repositories]"
                                      Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
            </StackPanelWidget>

            <StackPanelWidget Direction="Horizontal">
                <CanvasWidget Size="350, 90">
                    <LabelWidget Text="[ContentScreen:RemoteDescription]" Color="128, 128, 128" WordWrap="true"
                                 HorizontalAlignment="Far" VerticalAlignment="Center"
                                 TextAnchor="VerticalCenter, HorizontalCenter"/>
                </CanvasWidget>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Remote" Text="[ContentScreen:Remote]" Style="{Styles/ButtonStyle_310x60}"
                                      VerticalAlignment="Center"/>
            </StackPanelWidget>

            <StackPanelWidget Direction="Horizontal">
                <CanvasWidget Size="350, 90">
                    <LabelWidget Text="[ContentScreen:PackagesDescription]" Color="128, 128, 128" WordWrap="true"
                                 HorizontalAlignment="Far" VerticalAlignment="Center"
                                 TextAnchor="VerticalCenter, HorizontalCenter"/>
                </CanvasWidget>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Packages" Text="[ContentScreen:Packages]" Style="{Styles/ButtonStyle_310x60}"
                                      VerticalAlignment="Center"/>
            </StackPanelWidget>

            <StackPanelWidget Direction="Horizontal">
                <CanvasWidget Size="350, 90">
                    <LabelWidget Text="[ContentScreen:12]" Color="128, 128, 128" WordWrap="true"
                                 HorizontalAlignment="Far" VerticalAlignment="Center"
                                 TextAnchor="VerticalCenter, HorizontalCenter"/>
                </CanvasWidget>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Mods" Text="[ContentScreen:13]" Style="{Styles/ButtonStyle_310x60}"
                                      VerticalAlignment="Center"/>
            </StackPanelWidget>

            <StackPanelWidget Direction="Horizontal">
                <CanvasWidget Size="350, 90">
                    <LabelWidget Text="[ContentScreen:ServerSourcesDescription]" Color="128, 128, 128"
                                 WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                 TextAnchor="VerticalCenter, HorizontalCenter"/>
                </CanvasWidget>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="ServerSources" Text="[ContentScreen:ServerSources]"
                                      Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
            </StackPanelWidget>

            <StackPanelWidget Direction="Horizontal">
                <CanvasWidget Size="350, 90">
                    <LabelWidget Text="[ContentScreen:ManageServerSourcesDescription]" Color="128, 128, 128"
                                 WordWrap="true" HorizontalAlignment="Far" VerticalAlignment="Center"
                                 TextAnchor="VerticalCenter, HorizontalCenter"/>
                </CanvasWidget>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="ManageServerSources" Text="[ContentScreen:ManageServerSources]"
                                      Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center"/>
            </StackPanelWidget>

            <StackPanelWidget Direction="Horizontal">
                <CanvasWidget Size="350, 90">
                    <LabelWidget Text="[ContentScreen:8]" Color="128, 128, 128" WordWrap="true"
                                 HorizontalAlignment="Far" VerticalAlignment="Center"
                                 TextAnchor="VerticalCenter, HorizontalCenter"/>
                </CanvasWidget>
                <CanvasWidget Size="10, 0"/>
                <BevelledButtonWidget Name="Manage" Text="[ContentScreen:9]" Style="{Styles/ButtonStyle_310x60}"
                                      VerticalAlignment="Center"/>
            </StackPanelWidget>

                </StackPanelWidget>
            </ScrollPanelWidget>
        </CanvasWidget>

    </StackPanelWidget>

</Screen>
