<Dialog xmlns="runtime-namespace:Game.Widgets">

    <CanvasWidget Margin="0, 0" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="12, 10">

            <CanvasWidget Size="580, 350" HorizontalAlignment="Center">
                <BevelledRectangleWidget Style="{Styles/DialogArea}"/>
                <ScrollPanelWidget Direction="Vertical" Margin="8, 5">
                    <StackPanelWidget Name="StatsPanel" Direction="Vertical" Margin="8, 0"
                                      HorizontalAlignment="Center"/>
                </ScrollPanelWidget>
            </CanvasWidget>

            <CanvasWidget Size="0, 10"/>

            <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">
                <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center">
                    <BevelledButtonWidget Name="Resume" Size="160, 60" Text="[GameMenuDialog:1]"
                                          HorizontalAlignment="Center" Margin="5, 0"/>
                    <BevelledButtonWidget Name="Quit" Size="160, 60" Text="[GameMenuDialog:2]"
                                          HorizontalAlignment="Center" Margin="5, 0"/>
                    <BevelledButtonWidget Name="More" Size="160, 60" Text="[GameMenuDialog:3]"
                                          HorizontalAlignment="Center" Margin="5, 0"/>
                </StackPanelWidget>
            </StackPanelWidget>

        </StackPanelWidget>
    </CanvasWidget>

</Dialog>
