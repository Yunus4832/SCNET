<CanvasWidget xmlns="runtime-namespace:Game.Widgets">

    <CanvasWidget Size="960, 420" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
        <RectangleWidget FillColor="0, 0, 0, 255" OutlineColor="128, 128, 128, 128" OutlineThickness="2"/>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="0, 15">

            <LabelWidget Text="[ManipulateOfflineTokenDialog:1]" HorizontalAlignment="Center"/>

            <CanvasWidget Size="0, 5"/>

            <CanvasWidget Size="Infinity, 40">
                <LabelWidget Color="128, 128, 128" Text="[ManipulateOfflineTokenDialog:2]" HorizontalAlignment="Center"
                             TextAnchor="HorizontalCenter" WordWrap="true" Margin="10, 0"/>
            </CanvasWidget>

            <CanvasWidget Size="0, Infinity"/>

            <StackPanelWidget>
                <CanvasWidget Size="180, 70">
                    <LabelWidget Text="[ManipulateOfflineTokenDialog:3]" Color="128, 128, 128" HorizontalAlignment="Far"
                                 VerticalAlignment="Center"/>
                </CanvasWidget>
                <CanvasWidget Size="20, 0"/>
                <CanvasWidget Size="Infinity, 45" VerticalAlignment="Center">
                    <RectangleWidget FillColor="0, 0, 0, 192" OutlineColor="48, 48, 48, 48"/>
                    <TextBoxWidget Name="ManipulateOfflineTokenDialog.Token" Size="Infinity, 45" Margin="10, 0"
                                   MaximumLength="36"/>
                </CanvasWidget>
                <CanvasWidget Size="30, 0"/>
            </StackPanelWidget>

            <CanvasWidget Size="0, Infinity"/>

            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center">
                <BevelledButtonWidget Name="ManipulateOfflineTokenDialog.Create" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ManipulateOfflineTokenDialog:4]"/>
                <CanvasWidget Size="40, 0"/>
                <BevelledButtonWidget Name="ManipulateOfflineTokenDialog.Copy" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ManipulateOfflineTokenDialog:5]"/>
                <CanvasWidget Size="40, 0"/>
                <BevelledButtonWidget Name="ManipulateOfflineTokenDialog.Paste" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ManipulateOfflineTokenDialog:6]"/>
                <CanvasWidget Size="40, 0"/>
                <BevelledButtonWidget Name="ManipulateOfflineTokenDialog.Save" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ManipulateOfflineTokenDialog:7]"/>
                <CanvasWidget Size="40, 0"/>
                <BevelledButtonWidget Name="ManipulateOfflineTokenDialog.Cancel" Style="{Styles/ButtonStyle_160x60}"
                                      Text="[ManipulateOfflineTokenDialog:8]"/>
            </StackPanelWidget>

        </StackPanelWidget>
    </CanvasWidget>

</CanvasWidget>
