<CanvasWidget xmlns="runtime-namespace:Game.Widgets">
    <CanvasWidget Size="600, 285" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
        <BevelledRectangleWidget Style="{Styles/DialogArea}"/>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="20, 10">
            <LabelWidget Name="ContentRepositoryDialog.Title" Color="255, 255, 255"
                         HorizontalAlignment="Center" Margin="0, 5"/>
            <CanvasWidget Size="0, 8"/>
            <CanvasWidget Size="532, 50" HorizontalAlignment="Center">
                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                <CanvasWidget Size="Infinity, Infinity" Margin="10, 0">
                    <LabelWidget Name="ContentRepositoryDialog.NamePlaceholder" Color="128, 128, 128" Ellipsis="true" MaxLines="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="false"/>
                    <TextBoxWidget Name="ContentRepositoryDialog.Name" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </CanvasWidget>
            </CanvasWidget>
            <CanvasWidget Size="0, 8"/>
            <CanvasWidget Size="532, 50" HorizontalAlignment="Center">
                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                <CanvasWidget Size="Infinity, Infinity" Margin="10, 0">
                    <LabelWidget Name="ContentRepositoryDialog.AddressPlaceholder" Color="128, 128, 128" Ellipsis="true" MaxLines="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="false"/>
                    <TextBoxWidget Name="ContentRepositoryDialog.Address" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </CanvasWidget>
            </CanvasWidget>
            <CanvasWidget Size="0, 18"/>
            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center">
                <BevelledButtonWidget Name="ContentRepositoryDialog.Save" Style="{Styles/ButtonStyle_160x60}"/>
                <CanvasWidget Size="40, 0"/>
                <BevelledButtonWidget Name="ContentRepositoryDialog.Cancel" Text="[TextBoxDialog:2]"
                                      Style="{Styles/ButtonStyle_160x60}"/>
            </StackPanelWidget>
        </StackPanelWidget>
    </CanvasWidget>
</CanvasWidget>
