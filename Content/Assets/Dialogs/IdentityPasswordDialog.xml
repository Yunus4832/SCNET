<Dialog xmlns="runtime-namespace:Game.Widgets">
    <CanvasWidget Size="600, 360" HorizontalAlignment="Center" VerticalAlignment="Center" ClampToBounds="true">
        <BevelledRectangleWidget Style="{Styles/DialogArea}"/>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <LabelWidget Name="Title" Size="550, 60" WordWrap="true" FontScale="0.85" TextAnchor="HorizontalCenter, VerticalCenter"/>
            <LabelWidget Text="[SettingsIdentityScreen:Password]" FontScale="0.8" Margin="0, 4"/>
            <CanvasWidget Size="520, 44">
                <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                <TextBoxWidget Name="Password" IsPassword="true" MaximumLength="128" Margin="10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </CanvasWidget>
            <StackPanelWidget Name="Confirmation" Direction="Vertical">
                <LabelWidget Text="[SettingsIdentityScreen:ConfirmPassword]" FontScale="0.8" Margin="0, 4"/>
                <CanvasWidget Size="520, 44">
                    <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                    <TextBoxWidget Name="RepeatPassword" IsPassword="true" MaximumLength="128" Margin="10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </CanvasWidget>
            </StackPanelWidget>
            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="0, 12">
                <BevelledButtonWidget Name="Confirm" Style="{Styles/ButtonStyle_160x60}"/>
                <CanvasWidget Size="30, 0"/>
                <BevelledButtonWidget Name="Cancel" Style="{Styles/ButtonStyle_160x60}"/>
            </StackPanelWidget>
        </StackPanelWidget>
    </CanvasWidget>
</Dialog>
