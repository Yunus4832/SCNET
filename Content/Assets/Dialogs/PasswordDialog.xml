<Dialog xmlns="runtime-namespace:Game.Widgets">
    <CanvasWidget Name="Surface" Size="600, 300" HorizontalAlignment="Center" VerticalAlignment="Center" ClampToBounds="true">
        <BevelledRectangleWidget Style="{Styles/DialogArea}"/>
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="20, 10">
            <LabelWidget Name="Title" Size="540, -1" WordWrap="true" Color="255, 255, 255" HorizontalAlignment="Center" TextAnchor="HorizontalCenter" Margin="0, 5"/>
            <CanvasWidget Size="0, Infinity"/>
            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="0, 4">
                <LabelWidget Name="PasswordLabel" Text="[PasswordDialog:Password]" Size="160, 50" Color="180, 180, 180" WordWrap="true" TextAnchor="Right, VerticalCenter" VerticalAlignment="Center"/>
                <CanvasWidget Size="12, 0"/>
                <CanvasWidget Size="360, 50">
                    <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                    <CanvasWidget Size="Infinity, Infinity" Margin="10, 0">
                        <LabelWidget Name="PasswordPlaceholder" Color="128, 128, 128" Ellipsis="true" MaxLines="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="false"/>
                        <TextBoxWidget Name="Password" IsPassword="true" MaximumLength="128" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </CanvasWidget>
                </CanvasWidget>
            </StackPanelWidget>
            <StackPanelWidget Name="Confirmation" Direction="Horizontal" HorizontalAlignment="Center" Margin="0, 4">
                <LabelWidget Text="[PasswordDialog:Repeat]" Size="160, 50" Color="180, 180, 180" WordWrap="true" TextAnchor="Right, VerticalCenter" VerticalAlignment="Center"/>
                <CanvasWidget Size="12, 0"/>
                <CanvasWidget Size="360, 50">
                    <BevelledRectangleWidget Style="{Styles/TextBoxArea}"/>
                    <CanvasWidget Size="Infinity, Infinity" Margin="10, 0">
                        <LabelWidget Name="RepeatPlaceholder" Text="[PasswordDialog:RepeatPlaceholder]" Color="128, 128, 128" Ellipsis="true" MaxLines="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="false"/>
                        <TextBoxWidget Name="RepeatPassword" IsPassword="true" MaximumLength="128" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </CanvasWidget>
                </CanvasWidget>
            </StackPanelWidget>
            <CheckboxWidget Name="Remember" Text="[PasswordDialog:Remember]" Size="532, 44" Margin="0, 4" IsVisible="false"/>
            <CanvasWidget Size="0, Infinity"/>
            <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center">
                <BevelledButtonWidget Name="Confirm" Style="{Styles/ButtonStyle_160x60}"/>
                <CanvasWidget Size="40, 0"/>
                <BevelledButtonWidget Name="Cancel" Style="{Styles/ButtonStyle_160x60}"/>
            </StackPanelWidget>
        </StackPanelWidget>
    </CanvasWidget>
</Dialog>
