<CanvasWidget xmlns="runtime-namespace:Game.Widgets">
    <CanvasWidget Name="ListSelectionDialog.Content" HorizontalAlignment="Center" VerticalAlignment="Center" ClampToBounds="true">
        <BevelledRectangleWidget Style="{Styles/DialogArea}"/>
        <LabelWidget Name="ListSelectionDialog.Title" Color="255, 255, 255" TextAnchor="HorizontalCenter, VerticalCenter" Ellipsis="true" MaxLines="1"/>
        <CanvasWidget Name="ListSelectionDialog.Viewport" ClampToBounds="true">
            <ListPanelWidget Name="ListSelectionDialog.List" Direction="Vertical" IsScrollBarVisible="false" SelectionColor="0, 0, 0, 0"/>
        </CanvasWidget>
        <BevelledRectangleWidget Name="ListSelectionDialog.ScrollThumb" CenterColor="110, 110, 110" BevelColor="110, 110, 110" BevelSize="0" RoundingRadius="1.5" RoundingCount="4" AmbientLight="1" DirectionalLight="0" ShadowColor="0, 0, 0, 0" IsVisible="false"/>
    </CanvasWidget>
</CanvasWidget>
