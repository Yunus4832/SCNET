<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>$(GameProtocolPackageVersion)</Version>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <AssemblyName>SCNET.Game.Protocol</AssemblyName>
        <RootNamespace>Game.Protocol</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.Game.Protocol</PackageId>
        <Description>SCNET game message contracts and binary wire codecs.</Description>
        <!-- 解码入口先由 ProtocolShapeGuard 拒绝缺失字段，保留 init 属性及其构造默认值。 -->
        <NoWarn>$(NoWarn);MsgPack017</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Engine.Core/Engine.Core.csproj"/>
        <PackageReference Include="MessagePack" Version="3.1.9"/>
        <AssemblyMetadata Include="GameProtocolVersion" Value="$(GameProtocolVersion)"/>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>
</Project>
