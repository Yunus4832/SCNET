<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>$(GameVersion)</Version>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <RootNamespace>Game</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>SCNET.Survivalcraft.Hosting</PackageId>
        <Description>Game host configuration and orchestration independent of presentation.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Survivalcraft.Core/Survivalcraft.Core.csproj"/>
        <ProjectReference Include="../Authentication.Protocol/Authentication.Protocol.csproj"/>
        <ProjectReference Include="../Content.Packaging/Content.Packaging.csproj"/>
        <ProjectReference Include="../ServerSource.Protocol/ServerSource.Protocol.csproj"/>
        <ProjectReference Include="../Engine.Network/Engine.Network.csproj"/>
        <ProjectReference Include="../Engine.Media/Engine.Media.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Survivalcraft.Test</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Survivalcraft.Hosting.Test</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <Target Name="ValidateAssemblyBoundary" AfterTargets="ResolveReferences">
        <ItemGroup>
            <_ForbiddenAssemblyReference Include="@(ReferencePath)"
                                         Condition="'%(Filename)' == 'Survivalcraft' Or '%(Filename)' == 'Survivalcraft.Client' Or '%(Filename)' == 'Engine'"/>
        </ItemGroup>
        <Error Condition="'@(_ForbiddenAssemblyReference)' != ''"
               Text="$(MSBuildProjectName) must not depend on: @(_ForbiddenAssemblyReference->'%(Filename)', ', ')."/>
    </Target>
</Project>
