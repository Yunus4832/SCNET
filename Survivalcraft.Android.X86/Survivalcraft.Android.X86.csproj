<Project Sdk="Microsoft.NET.Sdk" InitialTargets="PackResource">
    <PropertyGroup>
        <RuntimeIdentifier>android-x86</RuntimeIdentifier>
    </PropertyGroup>

    <Import Project="..\SharedProperties\AndroidApplication.props"/>
    <Import Project="..\SharedProperties\AndroidVariant.props"/>

    <!-- Release 配置 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputApkName>SCNET_X86-$(ScnetVersion).apk</OutputApkName>
    </PropertyGroup>

    <ItemGroup>
        <!-- 这里的 TargetFramework, RuntimeIdentifier 必须硬编码，MSBuild 的限制，请勿修改 -->
        <ProjectReference Include="..\Survivalcraft\Survivalcraft.csproj" SetTargetFramework="TargetFramework=net10.0-android36.0">
            <AdditionalProperties>RuntimeIdentifier=android-x86</AdditionalProperties>
        </ProjectReference>
    </ItemGroup>
</Project>
