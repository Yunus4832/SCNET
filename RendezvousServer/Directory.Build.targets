<Project>
    <Import Project="../Directory.Build.targets"/>
    <PropertyGroup>
        <BuildRendezvousServerArtifacts Condition="'$(BuildRendezvousServerArtifacts)' == ''">true</BuildRendezvousServerArtifacts>
    </PropertyGroup>
    <Target Name="BuildRendezvousServerContainer" AfterTargets="Publish"
            Condition="'$(Configuration)' == 'Release' AND '$(BuildRendezvousServerArtifacts)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <RendezvousServerPublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</RendezvousServerPublishDirectory>
        </PropertyGroup>
        <Exec Command="bash &quot;$(MSBuildProjectDirectory)/Deployment/build-image.sh&quot;"
              EnvironmentVariables="RENDEZVOUSSERVER_PUBLISH_DIR=$(RendezvousServerPublishDirectory);SCNET_VERSION=$(ScnetVersion);DOTNET_SDK_VERSION=$(NETCoreSdkVersion);PLATFORM=linux/amd64"
              Condition="$([MSBuild]::IsOSPlatform('Linux'))"/>
        <Message Text="[RendezvousServer] 当前系统不是 Linux，已跳过容器镜像打包。" Importance="high"
                 Condition="!$([MSBuild]::IsOSPlatform('Linux'))"/>
    </Target>
</Project>
