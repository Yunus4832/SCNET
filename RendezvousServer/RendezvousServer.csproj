<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <TargetFramework>$(GlobalTargetFramework)</TargetFramework>
        <UseAppHost>false</UseAppHost>
        <SelfContained>false</SelfContained>
        <UsePackOutputTarget Condition="'$(Configuration)' == 'Release'">true</UsePackOutputTarget>
        <OutputFileName>rendezvous-server-$(ScnetVersion)-portable.zip</OutputFileName>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="0.9.5.2"/>
        <ProjectReference Include="../Rendezvous.Protocol/Rendezvous.Protocol.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="Deployment/run.sh" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
